---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {getTags, tagHref, BASE} from '../../lib/episodes';
const tags = getTags();
const definitions = [
  {title: '计算机网络', names: ['网络基础', 'HTTP', 'HTTPS', 'DNS', 'Cookie', 'Session', 'CDN', '负载均衡', '浏览器缓存']},
  {title: '数据与缓存', names: ['数据库', 'MySQL', '缓存', '服务端缓存', '索引', '事务', '锁', '主从复制']},
  {title: '分布式', names: ['分库分表', '分布式ID', '分布式事务']},
  {title: '系统与后端', names: ['后端', '性能', '高并发', '高可用', '消息队列', '限流', '幂等', '熔断', '降级']},
  {title: 'Agent 开发', names: ['人工智能', 'Agent']},
  {title: '算法可视化', names: ['算法', '双指针', 'LeetCode']},
  {title: '设计模式', names: ['设计模式', '策略模式', '代码设计']},
];
const groupedNames = new Set(definitions.flatMap((group) => group.names));
const groups = definitions.map((group) => ({title: group.title, tags: group.names.flatMap((name) => {
  const tag = tags.find((item) => item.name === name);
  return tag ? [tag] : [];
})})).filter((group) => group.tags.length);
const remaining = tags.filter((tag) => !groupedNames.has(tag.name));
if (remaining.length) groups.push({title: '更多知识点', tags: remaining});
---
<BaseLayout title="标签索引" current="library" description="按知识点查找 IT小村的视频与图文，浏览计算机网络、MySQL、高并发、高可用、高性能、分布式、Agent、算法和设计模式标签。">
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '全部内容', href: `${BASE}library/`}, {label: '标签索引'}]} />
    <header class="page-intro"><p class="eyebrow">TOPIC INDEX</p><h1>按知识点查找。</h1><p>从熟悉的术语出发，找到相关的视频与图文。同一篇内容可以关联多个标签。</p><nav class="index-actions" aria-label="其他浏览方式"><a class="text-link" href={`${BASE}library/`}>浏览全部内容 <span aria-hidden="true">→</span></a><a class="text-link" href={`${BASE}learn/`}>按学习路线开始 <span aria-hidden="true">→</span></a></nav></header>
    <div class="section-heading"><div><p class="eyebrow">EXPLORE TOPICS</p><h2>标签索引</h2></div><p class="tag-total">{tags.length} 个知识点</p></div>
    <div class="tag-groups">{groups.map((group) => <section class="tag-group" aria-label={group.title}><h3>{group.title}</h3><ul role="list">{group.tags.map((tag) => <li><a href={tagHref(tag.name)}><span>{tag.name}</span><span class="tag-count num">{tag.count}<span class="sr-only"> 篇内容</span></span></a></li>)}</ul></section>)}</div>
  </div>
</BaseLayout>
<style>
.index-actions{display:flex;gap:var(--sp-5);flex-wrap:wrap;margin-top:var(--sp-5)}.tag-total{margin:0!important;font-size:var(--fs-small);color:var(--c-text-2)}.tag-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-5)}.tag-group{border:1px solid var(--c-border);border-radius:var(--r-md);padding:var(--sp-5);background:var(--c-surface)}.tag-group h3{font-size:var(--fs-small);margin:0 0 var(--sp-4);color:var(--c-text-2)}.tag-group ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-2) var(--sp-5);list-style:none;padding:0;margin:0}.tag-group a{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-2);min-height:44px;font-size:var(--fs-small);color:var(--c-text);text-decoration:none;border-bottom:1px solid var(--c-border)}.tag-group a:hover{color:var(--c-primary);border-bottom-color:var(--c-primary-a40)}.tag-count{font-size:var(--fs-xs);color:var(--c-muted)}
@media(max-width:767px){.tag-groups{grid-template-columns:1fr;gap:var(--sp-4)}.tag-group{padding:var(--sp-4)}.tag-group ul{column-gap:var(--sp-4)}.index-actions{gap:var(--sp-4)}}
</style>
