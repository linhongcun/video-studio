---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EpisodeGrid from '../../components/EpisodeGrid.astro';
import TagPill from '../../components/TagPill.astro';
import EmptyState from '../../components/EmptyState.astro';
import {getEpisodes, getTags, tagHref, BASE} from '../../lib/episodes';
export function getStaticPaths() {
  return getTags().map((t) => ({params: {tag: t.name}, props: {t}}));
}
const {t} = Astro.props;
const eps = getEpisodes().filter((e) => e.tags.includes(t.name));
const others = getTags().filter((x) => x.name !== t.name);
---
<BaseLayout title={`#${t.name}`} description={t.description} current="library">
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '标签索引', href: `${BASE}tags/`}, {label: t.name}]} />
    <header class="page-intro"><p class="eyebrow">TOPIC / {t.name}</p><h1>#{t.name}</h1><p>{t.description}</p><div class="tag-context"><span>共 {eps.length} 篇相关内容</span><a class="text-link" href={`${BASE}tags/`}>返回标签索引 <span aria-hidden="true">↗</span></a></div></header>
    {eps.length ? <EpisodeGrid episodes={eps} /> : <EmptyState message="这个标签还没有内容" />}
    {others.length > 0 && <details class="other-tags"><summary>查找其他知识点</summary><div class="tag-list">{others.map((other) => <TagPill tag={other.name} href={tagHref(other.name)} />)}</div></details>}
  </div>
</BaseLayout>
<style>
.tag-context{display:flex;align-items:center;gap:var(--sp-5);flex-wrap:wrap;margin-top:var(--sp-5);font-size:var(--fs-small);color:var(--c-text-2)}.other-tags{margin-top:var(--sp-7);border-top:1px solid var(--c-border);padding-top:var(--sp-5)}.other-tags summary{cursor:pointer;font-size:var(--fs-small);color:var(--c-text-2);width:fit-content;min-height:44px}.tag-list{display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-top:var(--sp-3)}
@media(max-width:767px){.tag-context{gap:var(--sp-3)}.other-tags{margin-top:var(--sp-6)}}
</style>
