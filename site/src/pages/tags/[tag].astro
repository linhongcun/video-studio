---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EpisodeGrid from '../../components/EpisodeGrid.astro';
import TagPill from '../../components/TagPill.astro';
import EmptyState from '../../components/EmptyState.astro';
import {getEpisodes, getTags, tagHref, BASE} from '../../lib/episodes';
export function getStaticPaths() {
  return getTags().map((t) => ({params: {tag: t.name}, props: {t}}));
}
const {t} = Astro.props;
const eps = getEpisodes().filter((e) => e.tags.includes(t.name));
const others = getTags().filter((x) => x.name !== t.name);
---
<BaseLayout title={`#${t.name}`} description={t.description} current="tags">
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '专题', href: `${BASE}tags/`}, {label: t.name}]} />
    <div class="head"><h1>#{t.name}</h1><span class="num">共 {eps.length} 期</span></div>
    <p class="desc">{t.description}</p>
    {others.length > 0 && <p class="others">其他专题：{others.map((o) => <TagPill tag={o.name} href={tagHref(o.name)} />)}</p>}
    {eps.length ? <EpisodeGrid episodes={eps} /> : <EmptyState message="这个标签还没有片子" />}
  </div>
</BaseLayout>
<style>
.head{display:flex;justify-content:space-between;align-items:baseline;gap:var(--sp-4)}
h1{font-size:var(--fs-h1);margin:0}.head span{color:var(--c-text-2);font-size:var(--fs-small)}
.desc{color:var(--c-text-2);margin:var(--sp-2) 0 var(--sp-4)}
.others{display:flex;gap:var(--sp-2);align-items:center;flex-wrap:wrap;font-size:var(--fs-small);color:var(--c-text-2);margin:0 0 var(--sp-5)}
</style>
