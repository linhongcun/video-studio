---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import ChapterHeading from '../../../components/ChapterHeading.astro';
import ChapterHeading3 from '../../../components/ChapterHeading3.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import Callout from '../../../components/Callout.astro';
import Figure from '../../../components/Figure.astro';
import SourceQuote from '../../../components/SourceQuote.astro';
import Steps from '../../../components/Steps.astro';
import Summary from '../../../components/Summary.astro';
import BehindTheScenes from '../../../components/BehindTheScenes.astro';
import MusicCredit from '../../../components/MusicCredit.astro';
import EpisodePager from '../../../components/EpisodePager.astro';
import EpisodeNumbering from '../../../components/EpisodeNumbering.astro';
import Toc from '../../../components/Toc.astro';
import RelatedEpisodes from '../../../components/RelatedEpisodes.astro';
import PlatformLinks from '../../../components/PlatformLinks.astro';
import {episodeSourceLinks} from '../../../lib/source-links.mjs';
import {getEpisodes, getRelated, getAllMeta, SHOW_DRAFTS, BASE, asset, fmtTime, epLabel, tagHref, fmtDate, fmtVersion, dateIso, isNew, isoDuration, seriesNav, seriesFor, seriesHref, additionalSeriesFor, LEGACY_LABEL, learningGuideFor, archiveReplacementsFor, epHref} from '../../../lib/episodes';
export function getStaticPaths() {
  const eps = getEpisodes({includeArchived: true});
  const current = getEpisodes();
  const pages = eps.map((e) => {
    const i = current.findIndex((lesson) => lesson.slug === e.slug);
    return {params: {slug: e.slug}, props: {e, prev: i >= 0 ? current[i + 1] : undefined, next: i >= 0 ? current[i - 1] : undefined}};
  });
  // 未发布草稿：若有短版，旧链接临时跳转过去（避免 v0.3.0 已分享的 /episodes/http-request/ 404）
  const drafts = SHOW_DRAFTS ? [] : getAllMeta().filter((m) => m.draft && m.quickVersion);
  return [...pages, ...drafts.map((m) => ({params: {slug: m.slug}, props: {redirectTo: m.quickVersion}}))];
}
const {e, prev, next, redirectTo} = Astro.props;
if (redirectTo) return Astro.redirect(`${BASE}episodes/${redirectTo}/`);
const Content = e.Content;
const sourceResources = episodeSourceLinks(e);
// Markdown → 组件自动映射：Sorkin 的稿件无需改写
const sNav = seriesNav(e);
const series = seriesFor(e);
const additionalSeries = additionalSeriesFor(e);
const articleHeadings = e.chapters.filter((c) => c.inArticle);
const learningGuide = learningGuideFor(e);
const replacements = e.archived ? archiveReplacementsFor(e) : [];
const pageUrl = new URL(`${BASE}episodes/${e.slug}/`, Astro.site).href;
const abs = (u: string) => new URL(u, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'VideoObject', name: e.title, description: e.description ?? e.summary,
  thumbnailUrl: [abs(asset(e.slug, e.poster))], ...(e.publishedAt ? {uploadDate: dateIso(e.publishedAt)} : {}), duration: isoDuration(e.duration),
  contentUrl: abs(asset(e.slug, e.video)), embedUrl: pageUrl, inLanguage: 'zh-CN',
  dateCreated: dateIso(e.createdAt), dateModified: dateIso(e.updatedAt),
  publisher: {'@type': 'Organization', name: 'IT小村工作室', url: abs(BASE)},
};
const components = {h2: ChapterHeading, h3: ChapterHeading3, pre: CodeBlock, blockquote: Callout, Figure, SourceQuote, Callout, Steps, Summary, CodeBlock};
---
<BaseLayout title={e.title} description={(e as any).description ?? e.summary} ogImage={asset(e.slug, e.poster)} ogType="video.other" jsonLd={jsonLd} noIndex={e.archived}>
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, ...(series ? [{label: series.title, href: seriesHref(series.id)}] : e.tags[0] ? [{label: e.tags[0], href: tagHref(e.tags[0])}] : []), {label: sNav ? `本系列第 ${sNav.index}/${sNav.total} 课 · ${epLabel(e)}` : epLabel(e)}]} />
    {e.archived && <aside class="archive-notice" data-archived aria-labelledby="archive-title">
      <h2 id="archive-title">此合集已拆为独立短片</h2>
      <p>建议先看入门，再一次学习一种实现。此页保留合集版本供回看。</p>
      {replacements.length ? <ol>{replacements.map((lesson) => <li>{lesson.published
        ? <a href={epHref(lesson.slug)}>{epLabel(lesson)} · {lesson.title}</a>
        : <span>{epLabel(lesson)} · {lesson.title}（制作中）</span>}</li>)}</ol>
        : <p>独立短片正在制作。</p>}
    </aside>}
    <header class="eh" data-pagefind-body>
      {e.applicationScenario && <p class="eyebrow">Redis 应用场景 · {e.applicationScenario}</p>}
      <h1 data-pagefind-meta={`image:${asset(e.slug, e.poster)}`}>{e.title}</h1>
      {e.legacy && <p class="legacy" data-legacy>{LEGACY_LABEL}：这是早期版本，新版制作中，上线后会替换本页视频和文章。</p>}
      <p class="episode-version num"><time datetime={e.updatedAt} aria-label="当前版本">{fmtVersion(e.updatedAt)}</time>{e.publishedAt && isNew(e.publishedAt, e.slug) && <span class="new">NEW</span>}</p>
      <p class="meta num">
        <span>创建于 <time datetime={e.createdAt}>{fmtDate(e.createdAt)}</time></span>
        <span>· 修改于 <time datetime={e.updatedAt}>{fmtDate(e.updatedAt)}</time></span>
        <span>· 视频 {fmtTime(e.duration)}</span>
        {e.readMin > 0 && <span>· 约 {e.readMin} 分钟读完</span>}
        <span class="tags">· {e.tags.map((t) => <a href={tagHref(t)}>#{t}</a>)}</span>
      </p>
    </header>
    <nav class="reading-links" aria-label="选择阅读方式">
      <a href="#player"><span class="reading-icon" aria-hidden="true">▶</span><span>看视频 <small>{fmtTime(e.duration)}</small></span></a>
      <a href="#article"><span class="reading-icon" aria-hidden="true">≡</span><span>读图文 {e.readMin > 0 && <small>约 {e.readMin} 分钟</small>}</span></a>
      {sNav && <a href="#course-directory" data-open-course><span class="reading-icon" aria-hidden="true">☷</span><span>课程目录 <small>{sNav.total} 篇</small></span></a>}
      {additionalSeries.map((series) => <a href={seriesHref(series.id)}><span class="reading-icon" aria-hidden="true">↗</span><span>{series.title}<small>系列目录</small></span></a>)}
    </nav>
    <nav class="source-links" aria-label="制作文件">
      <span>制作文件</span>
      {sourceResources.map(({label, href}) => <a href={href} rel="noopener" target="_blank">{label} <small>GitHub ↗</small></a>)}
    </nav>
    <PlatformLinks platforms={e.platforms} />
    <VideoPlayer src={asset(e.slug, e.video)} poster={asset(e.slug, e.poster)} captions={`${BASE}episodes/${e.slug}/captions.vtt`} burnedInCaptions={e.burnedInCaptions} chapters={e.chapters} title={e.title} />
    {learningGuide && <a class="learning-guide" href={epHref(learningGuide.slug)} aria-label={`${e.learningGuide.label}：${learningGuide.title}`}>
      <span>{e.learningGuide.label}</span><strong>{learningGuide.title} →</strong>
    </a>}
    {sNav && <details class="course-directory" id="course-directory">
      <summary><span><span class="directory-label">课程目录</span><strong>{sNav.series.title}</strong></span><span class="directory-position">本系列第 {sNav.index} / {sNav.total} 课 <span class="directory-chevron" aria-hidden="true">⌄</span></span></summary>
      <div class="directory-note"><EpisodeNumbering inSeries /></div>
      <nav aria-label={`${sNav.series.title}课程目录`}><ol>{sNav.series.episodes.map((lesson, i) => <li>
        <a href={epHref(lesson.slug)} aria-current={lesson.slug === e.slug ? 'page' : undefined}>
          <span class="lesson-number num">{String(i + 1).padStart(2, '0')}</span><span class="lesson-title">{lesson.title}</span><span class="lesson-duration num">{fmtTime(lesson.duration)}</span>
        </a>
      </li>)}</ol></nav>
    </details>}
  </div>
  <div class="container art-grid">
    {articleHeadings.length > 0 && <aside class="toc-col"><Toc headings={articleHeadings} /></aside>}
    <article class="prose article-body" id="article" tabindex="-1" aria-label="图文讲解" data-pagefind-body>
      {Content && <Content components={components} />}
      <div class="article-end" data-pagefind-ignore>
        {!e.archived && <EpisodePager nav={sNav ?? {prev, next}} />}
        <RelatedEpisodes items={getRelated(e)} />
        <BehindTheScenes resources={sourceResources} />
        <MusicCredit />
      </div>
    </article>
  </div>
</BaseLayout>
<script>
  const courseDirectory = document.querySelector<HTMLDetailsElement>('#course-directory');
  document.querySelector<HTMLAnchorElement>('[data-open-course]')?.addEventListener('click', () => {
    if (courseDirectory) courseDirectory.open = true;
  });
  if (location.hash === '#course-directory' && courseDirectory) courseDirectory.open = true;
  // 正文“▶ 从这里看”→ 播放器；播放器当前章节 → 按钮文案“▶ 正在播放”
  document.querySelectorAll<HTMLAnchorElement>('[data-seek]').forEach((a) => a.addEventListener('click', (ev) => {
    ev.preventDefault(); window.dispatchEvent(new CustomEvent('vs:seek', {detail: {id: a.dataset.seek}}));
  }));
  document.querySelectorAll<HTMLAnchorElement>('[data-seek-time]').forEach((a) => a.addEventListener('click', (ev) => {
    ev.preventDefault(); window.dispatchEvent(new CustomEvent('vs:seek', {detail: {time: Number(a.dataset.seekTime)}}));
  }));
  window.addEventListener('vs:chapter', (ev: any) => {
    document.querySelectorAll<HTMLAnchorElement>('.chh [data-seek]').forEach((a) => {
      const on = ev.detail.playing && a.dataset.seek === ev.detail.id;
      a.textContent = on ? '▶ 正在播放' : '▶ 从这里看'; a.classList.toggle('playing', on);
    });
  });
  // 复制按钮
  document.querySelectorAll<HTMLButtonElement>('.cb-copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.code!); } catch { const t = document.createElement('textarea'); t.value = b.dataset.code!; document.body.append(t); t.select(); document.execCommand('copy'); t.remove(); }
    const live = b.nextElementSibling as HTMLElement; b.textContent = '已复制 ✓'; live.textContent = '已复制到剪贴板';
    setTimeout(() => { b.textContent = '复制'; live.textContent = ''; }, 2000);
  }));
</script>
<style>
.archive-notice{margin:var(--sp-4) 0;padding:var(--sp-4);border:1px solid var(--c-border);border-left:3px solid var(--c-primary);border-radius:var(--r-md);background:var(--c-surface)}
.archive-notice h2{margin:0 0 var(--sp-2);font-size:var(--fs-h3)}
.archive-notice p{margin:0 0 var(--sp-2);color:var(--c-text-2)}
.archive-notice ol{margin:0;padding-left:1.4em;line-height:1.8}
.archive-notice a{overflow-wrap:anywhere}
.learning-guide{display:flex;flex-wrap:wrap;gap:var(--sp-2) var(--sp-4);align-items:center;margin:var(--sp-4) 0;padding:var(--sp-3) var(--sp-4);border:1px solid var(--c-primary-a40);border-radius:var(--r-md);background:var(--c-surface);text-decoration:none}
.learning-guide span{color:var(--c-text-2);font-size:var(--fs-small)}
.learning-guide strong{color:var(--c-primary);font-size:var(--fs-small)}
.eh h1{font-size:var(--fs-h1);line-height:1.25;margin:0 0 var(--sp-2)}
.episode-version{display:flex;align-items:center;flex-wrap:wrap;gap:var(--sp-2);margin:0 0 var(--sp-3);color:var(--c-primary);font-size:var(--fs-small);font-weight:600}
.meta{color:var(--c-text-2);font-size:var(--fs-small);margin:0 0 var(--sp-5);display:flex;gap:var(--sp-2);flex-wrap:wrap}
.legacy{margin:0 0 var(--sp-3);padding:var(--sp-2) var(--sp-3);font-size:var(--fs-small);color:var(--c-text-2);background:var(--c-surface);border:1px dashed var(--c-border);border-radius:var(--r-md)}
.meta a{color:var(--c-tag)}
.meta .tags{display:inline-flex;flex-wrap:wrap;gap:var(--sp-1) var(--sp-2)}
.new{margin-left:6px;font-size:10px;font-weight:700;padding:2px 6px;border-radius:var(--r-full);background:var(--c-primary);color:var(--c-on-primary);vertical-align:1px}
.reading-links{display:flex;flex-wrap:wrap;gap:var(--sp-2);margin:var(--sp-5) 0 var(--sp-4)}
.reading-links a{display:flex;align-items:center;gap:var(--sp-2);padding:10px 16px;min-height:48px;border:1px solid var(--c-border);border-radius:var(--r-md);color:var(--c-text);font-size:var(--fs-small);font-weight:600;text-decoration:none;background:var(--c-surface)}
.reading-links a:hover{border-color:var(--c-primary-a40);color:var(--c-primary);filter:none}
.reading-links .reading-icon{color:var(--c-primary);font-size:16px;line-height:1}
.reading-links small{font-size:var(--fs-xs);color:var(--c-text-2);font-weight:400;margin-left:6px}
.source-links{display:flex;flex-wrap:wrap;align-items:center;gap:0 var(--sp-4);margin:calc(-1 * var(--sp-2)) 0 var(--sp-4);font-size:var(--fs-small)}
.source-links>span,.source-links small{color:var(--c-text-2);font-size:var(--fs-xs)}
.source-links a{display:inline-flex;align-items:center;gap:6px;min-height:44px;text-decoration:none}
.source-links a:hover{text-decoration:underline}
.course-directory{margin-top:var(--sp-5);border:1px solid var(--c-border);background:var(--c-surface);border-radius:var(--r-md);scroll-margin-top:calc(var(--header-h) + 16px)}
.course-directory summary{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-3);list-style:none;padding:var(--sp-4) var(--sp-5);cursor:pointer}
.course-directory summary::-webkit-details-marker{display:none}
.course-directory summary>span:first-child{display:flex;align-items:center;gap:var(--sp-4)}
.directory-label,.directory-position{color:var(--c-text-2);font-size:var(--fs-xs)}
.course-directory strong{font-size:var(--fs-small);font-weight:600}
.directory-position{display:flex;align-items:center;gap:var(--sp-3);white-space:nowrap}
.directory-chevron{font-size:18px;transition:transform var(--dur)}
.course-directory[open] .directory-chevron{transform:rotate(180deg)}
.course-directory nav{padding:0 var(--sp-5) var(--sp-4)}
.directory-note{padding-inline:var(--sp-5)}
.course-directory ol{list-style:none;padding:0;margin:0;display:grid;gap:var(--sp-1)}
.course-directory a{display:flex;align-items:center;gap:var(--sp-3);color:var(--c-text);text-decoration:none;padding:12px;border-radius:var(--r-sm);font-size:var(--fs-small);line-height:1.6;min-height:48px}
.course-directory a:hover{background:var(--c-surface-2);filter:none}
.course-directory a[aria-current]{background:var(--c-primary-a12);font-weight:600;color:var(--c-primary)}
.lesson-number{color:var(--c-muted);font-family:var(--font-mono);font-size:var(--fs-xs);flex:none}
.lesson-title{flex:1;min-width:0}
.lesson-duration{color:var(--c-text-2);font-family:var(--font-mono);font-size:var(--fs-xs);flex:none}
.art-grid{display:grid;grid-template-columns:minmax(0,var(--measure));justify-content:center;gap:var(--sp-5);margin-top:var(--sp-7)}
.article-body{scroll-margin-top:calc(var(--header-h) + 24px + var(--sticky-h,0px))}
.article-body:focus{outline:none;box-shadow:none}
.toc-col{min-width:0}
@media (min-width:1200px){.art-grid{grid-template-columns:minmax(0,var(--measure)) minmax(200px,240px);column-gap:var(--sp-7)}.article-body{grid-column:1;grid-row:1}.toc-col{grid-column:2;grid-row:1}}
@media (max-width:767px){.reading-links{gap:6px}.reading-links a{flex:1;justify-content:center;padding:10px 8px;gap:6px}.reading-links a>span:last-child{display:flex;flex-direction:column;gap:2px}.reading-links small{margin-left:0;font-size:11px}.course-directory summary{padding:var(--sp-4)}.course-directory summary>span:first-child{flex-direction:column;align-items:flex-start;gap:2px}.course-directory nav{padding:0 var(--sp-2) var(--sp-3)}.art-grid{margin-top:var(--sp-6)}}
</style>
<style is:global>
.prose{min-width:0}
.prose.article-body>:first-child{margin-top:0}
.prose>p,.prose li{line-height:1.8}
.prose p{margin:0 0 var(--sp-4)}
.prose h2{font-size:var(--fs-h2);line-height:1.35;margin:var(--sp-8) 0 var(--sp-4);scroll-margin-top:calc(var(--header-h) + 16px + var(--sticky-h,0px))}
.prose h3{font-size:var(--fs-h3);scroll-margin-top:calc(var(--header-h) + 16px + var(--sticky-h,0px))}
.prose :not(pre)>code{background:var(--c-surface-2);color:var(--c-primary);padding:1px 6px;border-radius:var(--r-sm);font-size:.9em}
.prose strong{color:var(--c-strong);font-weight:600}
/* 宽表格在自身容器内横向滚动，不撑宽整页（手机 390px 溢出的根因） */
.prose a,.prose :not(pre)>code{overflow-wrap:anywhere}
.prose .footnotes{overflow-wrap:anywhere}
.prose>figure{margin-inline:0}
.prose>figure:not(.source-quote){margin-block:var(--sp-5)}
.prose>figure:not(.source-quote)>svg{max-width:100%;height:auto}
/* Frame the artwork without recoloring its fixed teaching palette. */
.prose>figure:not(.source-quote)>svg,.prose>figure:not(.source-quote)>img,.prose .fig img{border:1px solid color-mix(in srgb,var(--c-text-2) 65%,var(--c-surface));border-radius:var(--r-md);background:var(--c-surface);box-shadow:var(--shadow-1)}
.prose>figure:not(.source-quote)>figcaption{margin-top:var(--sp-2);color:var(--c-text-2);font-size:var(--fs-small);line-height:1.7;text-align:left;overflow-wrap:anywhere}
.prose table{display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;border-collapse:collapse;margin:0 0 var(--sp-5);font-size:var(--fs-small)}
.prose th,.prose td{padding:6px 10px;border:1px solid var(--c-border);text-align:left;vertical-align:top}
.prose th{background:var(--c-surface-2);white-space:nowrap}
.prose ul,.prose ol{padding-left:1.4em;margin:0 0 var(--sp-4)}
.chh{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);flex-wrap:wrap}
.chh .t{position:relative}
.chh .anchor{margin-left:8px;color:var(--c-muted);text-decoration:none;opacity:0;font-weight:400}
.chh:hover .anchor,.chh .anchor:focus-visible{opacity:1}
.chh .from{font-size:var(--fs-small);font-weight:600;min-height:36px;padding:0 12px;flex:none}
.chh .from.playing{background:var(--c-primary-a20)}
@media (max-width:767px){.chh{flex-direction:column;align-items:flex-start;gap:var(--sp-2)}.chh .from{min-height:44px}}
.cb{margin:0 0 var(--sp-5);background:var(--c-code-bg);border:1px solid var(--c-border);border-radius:var(--r-md);overflow:hidden}
.cb-request{border-left:3px solid var(--c-secondary)}.cb-response{border-left:3px solid var(--c-success)}
.cb-bar{display:flex;justify-content:space-between;align-items:center;padding:6px 8px 6px 16px;border-bottom:1px solid var(--c-border);font-size:var(--fs-xs);color:var(--c-text-2)}
.cb-copy{min-height:32px;padding:0 12px;border-radius:var(--r-sm);border:1px solid var(--c-border);background:transparent;color:var(--c-text-2);font:inherit;cursor:pointer}
.cb-copy:hover{color:var(--c-text);border-color:var(--c-primary)}
.cb pre{margin:0;padding:var(--sp-4);overflow-x:auto;white-space:pre;font-size:var(--fs-code);line-height:1.65;color:var(--c-text)}
.h-method{color:var(--hl-method);font-weight:600}.h-path{color:var(--c-text)}.h-ver{color:var(--hl-ver)}
.h-ok{color:var(--hl-ok);font-weight:600}.h-redir{color:var(--hl-redir);font-weight:600}.h-err{color:var(--hl-err);font-weight:600}
.h-name{color:var(--hl-name)}.h-val{color:var(--c-text)}.h-nl{color:var(--hl-nl)}
.callout{display:flex;gap:var(--sp-3);margin:0 0 var(--sp-5);padding:var(--sp-3) var(--sp-4);border-left:3px solid var(--cc);background:color-mix(in srgb,var(--cc) 10%,transparent);border-radius:var(--r-md);color:var(--c-text)}
.callout-info{--cc:var(--c-secondary)}.callout-tip{--cc:var(--c-success)}.callout-warn{--cc:var(--c-accent)}.callout-danger{--cc:var(--c-danger)}
.callout .ci{color:var(--cc);font-weight:700;line-height:1.8}
.callout .cbody>:last-child{margin-bottom:0}.ctitle{font-weight:600;margin:0 0 var(--sp-1)}
.fig{margin:0 0 var(--sp-5)}.fig img{display:block;width:100%;border:1px solid var(--c-border);border-radius:var(--r-md);background:var(--c-surface)}
.fig.wide{margin-inline:calc((var(--measure) - min(960px,100vw - 2*var(--gutter)))/2)}
.fig figcaption{color:var(--c-text-2);font-size:var(--fs-small);text-align:left;margin-top:var(--sp-2)}
.steps{list-style:none;counter-reset:s;padding:0!important}
.steps>li{counter-increment:s;position:relative;padding-left:40px;margin-bottom:var(--sp-3)}
.steps>li::before{content:counter(s);position:absolute;left:0;top:2px;width:26px;height:26px;border-radius:50%;background:var(--c-surface-2);border:1px solid var(--c-primary);color:var(--c-primary);font-size:var(--fs-xs);display:grid;place-items:center}
.summary{margin-top:var(--sp-8);padding:var(--sp-5);background:var(--c-surface);border:1px solid var(--c-border);border-top:2px solid var(--c-primary);border-radius:var(--r-lg)}
.summary h2{margin:0 0 var(--sp-3)!important;font-size:var(--fs-h3)!important}
.summary ul{list-style:none;padding-left:0!important}
.summary ul>li{position:relative;padding-left:28px}
.summary ul>li::before{content:'✓';position:absolute;left:0;color:var(--c-success);font-weight:700}
.summary .callout{margin-top:var(--sp-4)}
</style>
