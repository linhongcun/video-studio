---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import ChapterHeading from '../../../components/ChapterHeading.astro';
import ChapterHeading3 from '../../../components/ChapterHeading3.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import Callout from '../../../components/Callout.astro';
import Figure from '../../../components/Figure.astro';
import Steps from '../../../components/Steps.astro';
import Summary from '../../../components/Summary.astro';
import BehindTheScenes from '../../../components/BehindTheScenes.astro';
import MusicCredit from '../../../components/MusicCredit.astro';
import EpisodePager from '../../../components/EpisodePager.astro';
import Toc from '../../../components/Toc.astro';
import RelatedEpisodes from '../../../components/RelatedEpisodes.astro';
import PlatformLinks from '../../../components/PlatformLinks.astro';
import {getEpisodes, getRelated, getAllMeta, SHOW_DRAFTS, REPO, BASE, asset, fmtTime, epLabel, tagHref, fmtDate, isNew, isoDuration, seriesNav, seriesHref, LEGACY_LABEL, learningGuideFor, epHref} from '../../../lib/episodes';
export function getStaticPaths() {
  const eps = getEpisodes();
  const pages = eps.map((e, i) => ({params: {slug: e.slug}, props: {e, prev: eps[i + 1], next: eps[i - 1]}}));
  // 未发布草稿：若有短版，旧链接临时跳转过去（避免 v0.3.0 已分享的 /episodes/http-request/ 404）
  const drafts = SHOW_DRAFTS ? [] : getAllMeta().filter((m) => m.draft && m.quickVersion);
  return [...pages, ...drafts.map((m) => ({params: {slug: m.slug}, props: {redirectTo: m.quickVersion}}))];
}
const {e, prev, next, redirectTo} = Astro.props;
if (redirectTo) return Astro.redirect(`${BASE}episodes/${redirectTo}/`);
const Content = e.Content;
const tree = `${REPO}/blob/main/episodes/${e.slug}`;
// Markdown → 组件自动映射：Sorkin 的稿件无需改写
const sNav = seriesNav(e);
const learningGuide = learningGuideFor(e);
const pageUrl = new URL(`${BASE}episodes/${e.slug}/`, Astro.site).href;
const abs = (u: string) => new URL(u, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'VideoObject', name: e.title, description: e.description ?? e.summary,
  thumbnailUrl: [abs(asset(e.slug, e.poster))], uploadDate: `${e.date}T00:00:00+08:00`, duration: isoDuration(e.duration),
  contentUrl: abs(asset(e.slug, e.video)), embedUrl: pageUrl, inLanguage: 'zh-CN',
  ...(e.updated ? {dateModified: `${e.updated}T00:00:00+08:00`} : {}),
  publisher: {'@type': 'Organization', name: 'IT小村工作室', url: abs(BASE)},
};
const components = {h2: ChapterHeading, h3: ChapterHeading3, pre: CodeBlock, blockquote: Callout, Figure, Callout, Steps, Summary, CodeBlock};
---
<BaseLayout title={e.title} description={(e as any).description ?? e.summary} ogImage={asset(e.slug, e.poster)} ogType="video.other" jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, ...(sNav ? [{label: sNav.series.title, href: seriesHref(sNav.series.id)}] : e.tags[0] ? [{label: e.tags[0], href: tagHref(e.tags[0])}] : []), {label: sNav ? `${epLabel(e)} · 第 ${sNav.index}/${sNav.total} 期` : epLabel(e)}]} />
    <header class="eh" data-pagefind-body>
      <h1 data-pagefind-meta={`image:${asset(e.slug, e.poster)}`}>{e.title}</h1>
      {e.legacy && <p class="legacy" data-legacy>{LEGACY_LABEL}：这是早期版本，新版制作中，上线后会替换本页视频和文章。</p>}
      <p class="meta num">
        <span><time datetime={e.date}>{fmtDate(e.date)}</time> 发布{isNew(e.date, e.slug) && <span class="new">NEW</span>}</span>
        {e.updated && <span>· 更新于 <time datetime={e.updated}>{fmtDate(e.updated)}</time></span>}
        <span>· 视频 {fmtTime(e.duration)}</span>
        {e.readMin > 0 && <span>· 约 {e.readMin} 分钟读完</span>}
        <span class="tags">· {e.tags.map((t) => <a href={tagHref(t)}>#{t}</a>)}</span>
      </p>
    </header>
    <PlatformLinks platforms={e.platforms} />
    <VideoPlayer src={asset(e.slug, e.video)} poster={asset(e.slug, e.poster)} captions={`${BASE}episodes/${e.slug}/captions.vtt`} chapters={e.chapters} title={e.title} />
    {learningGuide && <a class="learning-guide" href={epHref(learningGuide.slug)} aria-label={`${e.learningGuide.label}：${learningGuide.title}`}>
      <span>{e.learningGuide.label}</span><strong>{learningGuide.title} →</strong>
    </a>}
    <RelatedEpisodes items={getRelated(e)} />
  </div>
  <div class="container art-grid">
    <article class="prose" data-pagefind-body>
      {Content && <Content components={components} />}
      <div data-pagefind-ignore><MusicCredit />
      <BehindTheScenes script={`${tree}/script.md`} storyboard={`${tree}/storyboard.json`} source={`${REPO}/tree/main/${e.sourcePath}`} />
      <EpisodePager nav={sNav ?? {prev, next}} /></div>
    </article>
    <aside class="toc-col"><Toc headings={e.chapters.filter((c) => c.inArticle)} /></aside>
  </div>
</BaseLayout>
<script>
  // 正文“▶ 从这里看”→ 播放器；播放器当前章节 → 按钮文案“▶ 正在播放”
  document.querySelectorAll<HTMLAnchorElement>('[data-seek]').forEach((a) => a.addEventListener('click', (ev) => {
    ev.preventDefault(); window.dispatchEvent(new CustomEvent('vs:seek', {detail: {id: a.dataset.seek}}));
  }));
  window.addEventListener('vs:chapter', (ev: any) => {
    document.querySelectorAll<HTMLAnchorElement>('.chh [data-seek]').forEach((a) => {
      const on = ev.detail.playing && a.dataset.seek === ev.detail.id;
      a.textContent = on ? '▶ 正在播放' : '▶ 从这里看'; a.classList.toggle('playing', on);
    });
  });
  // 复制按钮
  document.querySelectorAll<HTMLButtonElement>('.cb-copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.code!); } catch { const t = document.createElement('textarea'); t.value = b.dataset.code!; document.body.append(t); t.select(); document.execCommand('copy'); t.remove(); }
    const live = b.nextElementSibling as HTMLElement; b.textContent = '已复制 ✓'; live.textContent = '已复制到剪贴板';
    setTimeout(() => { b.textContent = '复制'; live.textContent = ''; }, 2000);
  }));
</script>
<style>
.learning-guide{display:flex;flex-wrap:wrap;gap:var(--sp-2) var(--sp-4);align-items:center;margin:var(--sp-4) 0;padding:var(--sp-3) var(--sp-4);border:1px solid var(--c-primary-a40);border-radius:var(--r-md);background:var(--c-surface);text-decoration:none}
.learning-guide span{color:var(--c-text-2);font-size:var(--fs-small)}
.learning-guide strong{color:var(--c-primary);font-size:var(--fs-small)}
.eh h1{font-size:var(--fs-h1);line-height:1.25;margin:0 0 var(--sp-2)}
.meta{color:var(--c-text-2);font-size:var(--fs-small);margin:0 0 var(--sp-5);display:flex;gap:var(--sp-2);flex-wrap:wrap}
.legacy{margin:0 0 var(--sp-3);padding:var(--sp-2) var(--sp-3);font-size:var(--fs-small);color:var(--c-text-2);background:var(--c-surface);border:1px dashed var(--c-border);border-radius:var(--r-md)}
.meta a{color:var(--c-tag)}
.meta .tags{display:inline-flex;flex-wrap:wrap;gap:var(--sp-1) var(--sp-2)}
.new{margin-left:6px;font-size:10px;font-weight:700;padding:2px 6px;border-radius:var(--r-full);background:var(--c-primary);color:var(--c-on-primary);vertical-align:1px}
.art-grid{display:grid;grid-template-columns:minmax(0,var(--measure));justify-content:center;margin-top:var(--sp-7)}
.toc-col{display:none}
@media (min-width:1440px){.art-grid{grid-template-columns:1fr minmax(0,var(--measure)) 1fr;gap:var(--sp-6)}.prose{grid-column:2}.toc-col{display:block;grid-column:3;max-width:240px}}
</style>
<style is:global>
.prose{min-width:0}
.prose>p,.prose li{line-height:1.8}
.prose p{margin:0 0 var(--sp-4)}
.prose h2{font-size:var(--fs-h2);line-height:1.35;margin:var(--sp-8) 0 var(--sp-4);scroll-margin-top:calc(var(--header-h) + 16px + var(--sticky-h,0px))}
.prose h3{font-size:var(--fs-h3)}
.prose :not(pre)>code{background:var(--c-surface-2);color:var(--c-primary);padding:1px 6px;border-radius:var(--r-sm);font-size:.9em}
.prose strong{color:var(--c-strong);font-weight:600}
/* 宽表格在自身容器内横向滚动，不撑宽整页（手机 390px 溢出的根因） */
.prose a,.prose :not(pre)>code{overflow-wrap:anywhere}
.prose table{display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;border-collapse:collapse;margin:0 0 var(--sp-5);font-size:var(--fs-small)}
.prose th,.prose td{padding:6px 10px;border:1px solid var(--c-border);text-align:left;vertical-align:top}
.prose th{background:var(--c-surface-2);white-space:nowrap}
.prose ul,.prose ol{padding-left:1.4em;margin:0 0 var(--sp-4)}
.chh{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);flex-wrap:wrap}
.chh .t{position:relative}
.chh .anchor{margin-left:8px;color:var(--c-muted);text-decoration:none;opacity:0;font-weight:400}
.chh:hover .anchor,.chh .anchor:focus-visible{opacity:1}
.chh .from{font-size:var(--fs-small);font-weight:600;min-height:36px;padding:0 12px;flex:none}
.chh .from.playing{background:var(--c-primary-a20)}
@media (max-width:767px){.chh{flex-direction:column;align-items:flex-start;gap:var(--sp-2)}.chh .from{min-height:44px}}
.cb{margin:0 0 var(--sp-5);background:var(--c-code-bg);border:1px solid var(--c-border);border-radius:var(--r-md);overflow:hidden}
.cb-request{border-left:3px solid var(--c-secondary)}.cb-response{border-left:3px solid var(--c-success)}
.cb-bar{display:flex;justify-content:space-between;align-items:center;padding:6px 8px 6px 16px;border-bottom:1px solid var(--c-border);font-size:var(--fs-xs);color:var(--c-text-2)}
.cb-copy{min-height:32px;padding:0 12px;border-radius:var(--r-sm);border:1px solid var(--c-border);background:transparent;color:var(--c-text-2);font:inherit;cursor:pointer}
.cb-copy:hover{color:var(--c-text);border-color:var(--c-primary)}
.cb pre{margin:0;padding:var(--sp-4);overflow-x:auto;white-space:pre;font-size:var(--fs-code);line-height:1.65;color:var(--c-text)}
.h-method{color:var(--hl-method);font-weight:600}.h-path{color:var(--c-text)}.h-ver{color:var(--hl-ver)}
.h-ok{color:var(--hl-ok);font-weight:600}.h-redir{color:var(--hl-redir);font-weight:600}.h-err{color:var(--hl-err);font-weight:600}
.h-name{color:var(--hl-name)}.h-val{color:var(--c-text)}.h-nl{color:var(--hl-nl)}
.callout{display:flex;gap:var(--sp-3);margin:0 0 var(--sp-5);padding:var(--sp-3) var(--sp-4);border-left:3px solid var(--cc);background:color-mix(in srgb,var(--cc) 10%,transparent);border-radius:var(--r-md);color:var(--c-text)}
.callout-info{--cc:var(--c-secondary)}.callout-tip{--cc:var(--c-success)}.callout-warn{--cc:var(--c-accent)}.callout-danger{--cc:var(--c-danger)}
.callout .ci{color:var(--cc);font-weight:700;line-height:1.8}
.callout .cbody>:last-child{margin-bottom:0}.ctitle{font-weight:600;margin:0 0 var(--sp-1)}
.fig{margin:0 0 var(--sp-5)}.fig img{display:block;width:100%;border:1px solid var(--c-border);border-radius:var(--r-md);background:var(--c-surface)}
.fig.wide{margin-inline:calc((var(--measure) - min(960px,100vw - 2*var(--gutter)))/2)}
.fig figcaption{color:var(--c-text-2);font-size:var(--fs-small);text-align:center;margin-top:var(--sp-2)}
.steps{list-style:none;counter-reset:s;padding:0!important}
.steps>li{counter-increment:s;position:relative;padding-left:40px;margin-bottom:var(--sp-3)}
.steps>li::before{content:counter(s);position:absolute;left:0;top:2px;width:26px;height:26px;border-radius:50%;background:var(--c-surface-2);border:1px solid var(--c-primary);color:var(--c-primary);font-size:var(--fs-xs);display:grid;place-items:center}
.summary{margin-top:var(--sp-8);padding:var(--sp-5);background:var(--c-surface);border:1px solid var(--c-border);border-top:2px solid var(--c-primary);border-radius:var(--r-lg)}
.summary h2{margin:0 0 var(--sp-3)!important;font-size:var(--fs-h3)!important}
.summary ul{list-style:none;padding-left:0!important}
.summary ul>li{position:relative;padding-left:28px}
.summary ul>li::before{content:'✓';position:absolute;left:0;color:var(--c-success);font-weight:700}
.summary .callout{margin-top:var(--sp-4)}
</style>
