---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EpisodeNumbering from '../../components/EpisodeNumbering.astro';
import {getSeries, BASE, asset, epHref, epLabel, fmtTime} from '../../lib/episodes';
import {getLearningSeriesById} from '../../lib/learning';
export function getStaticPaths() {
  return getSeries().map((s) => ({params: {id: s.id}, props: {s}}));
}
const {s} = Astro.props;
const first = s.episodes[0];
const details = getLearningSeriesById(s.id);
const totalMinutes = Math.max(1, Math.round(s.episodes.reduce((total, e) => total + e.duration, 0) / 60));
---
<BaseLayout title={s.title} current="learn" description={s.description} ogImage={first && asset(first.slug, first.poster)}>
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '学习系列', href: `${BASE}learn/`}, {label: s.title}]} />
    <header class="page-intro">
      <p class="eyebrow">学习系列</p>
      <h1>{s.title}</h1>
      <p>{s.description}</p>
      <div class="intro-actions">
        {first && <a class="btn btn-primary" href={epHref(first.slug)}>从第一课开始 <span aria-hidden="true">→</span></a>}
        <span class="course-count">已发布 {s.episodes.length} 篇 · 视频共约 {totalMinutes} 分钟</span>
      </div>
    </header>
    <div class="series-overview">
      <div><h2>课程简介</h2><p>{s.independentLessons ? '每一课围绕一个完整问题展开，可以独立观看。按兴趣选择下方已发布内容，先看短片理解过程，再读图文查看细节与资料。' : '每一课围绕一个具体问题展开。先看短片理解过程，再读图文查看细节与资料，按下方顺序继续学习。'}</p></div>
      {details && <div><h2>适合谁</h2><p>{details.audience}</p></div>}
    </div>
    <section class="curriculum" aria-labelledby="curriculum-title">
      <div class="section-heading"><div><p class="eyebrow">CURRICULUM</p><h2 id="curriculum-title">课程目录</h2></div><a class="text-link" href={`${BASE}learn/`}>全部学习系列 <span aria-hidden="true">↗</span></a></div>
      <EpisodeNumbering inSeries />
      <ol class="lesson-list">
        {s.episodes.map((e, index) => <li><a class="lesson" href={epHref(e.slug)}>
          <span class="lesson-number num" aria-label={`本系列第 ${index + 1} 课`}>{String(index + 1).padStart(2, '0')}</span>
          <div class="lesson-cover"><img src={asset(e.slug, e.poster)} alt="" width="256" height="144" loading="lazy" decoding="async" /></div>
          <div class="lesson-info"><p class="lesson-meta"><span class="num">{epLabel(e)}</span>{e.applicationScenario && <span>应用场景 · {e.applicationScenario}</span>}<span>视频 {fmtTime(e.duration)}</span>{e.readMin > 0 && <span>图文约 {e.readMin} 分钟</span>}</p><h3>{e.title}</h3><p class="lesson-summary">{e.summary}</p></div>
          <span class="lesson-arrow" aria-hidden="true">↗</span>
        </a></li>)}
      </ol>
    </section>
    <p class="browse-note">想找其他知识点？<a href={`${BASE}library/`}>浏览全部内容</a>，或<a href={`${BASE}search/`}>搜索视频与图文</a>。</p>
  </div>
</BaseLayout>
<style>
.intro-actions{display:flex;align-items:center;gap:var(--sp-5);flex-wrap:wrap;margin-top:var(--sp-5)}.course-count{font-size:var(--fs-small);color:var(--c-text-2)}
.series-overview{display:grid;grid-template-columns:1.4fr 1fr;gap:var(--sp-8);padding:var(--sp-5) 0 var(--sp-6);border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border)}.series-overview h2{font-size:var(--fs-small);margin:0 0 var(--sp-2)}.series-overview p{margin:0;color:var(--c-text-2);font-size:var(--fs-small);max-width:46em}
.curriculum{margin-top:var(--sp-7)}.lesson-list{list-style:none;padding:0;margin:0;border-top:1px solid var(--c-border)}.lesson-list>li{border-bottom:1px solid var(--c-border)}.lesson{display:flex;gap:var(--sp-5);align-items:center;padding:var(--sp-5) var(--sp-3);color:var(--c-text);text-decoration:none;border-radius:var(--r-sm)}.lesson:hover{background:var(--c-surface)}.lesson-number{flex:none;min-width:24px;font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--c-primary)}.lesson-cover{width:152px;flex:none;border-radius:var(--r-sm);overflow:hidden;background:var(--c-surface-2);border:1px solid var(--c-border)}.lesson-cover img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.lesson-info{min-width:0;flex:1}.lesson-meta{display:flex;flex-wrap:wrap;gap:var(--sp-3);margin:0 0 var(--sp-1);font-size:var(--fs-xs);color:var(--c-text-2)}.lesson-meta .num{color:var(--c-primary)}.lesson-info h3{margin:0;font-size:var(--fs-h3);line-height:1.5;letter-spacing:-.02em}.lesson-summary{margin:var(--sp-2) 0 0;color:var(--c-text-2);font-size:var(--fs-small);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.lesson-arrow{flex:none;color:var(--c-primary);font-size:20px}.browse-note{margin:var(--sp-7) 0 0;color:var(--c-text-2);font-size:var(--fs-small)}
@media(max-width:767px){.series-overview{grid-template-columns:1fr;gap:var(--sp-5);padding-block:var(--sp-5)}.intro-actions{gap:var(--sp-3)}.course-count{font-size:var(--fs-xs)}.lesson{align-items:flex-start;gap:var(--sp-3);padding:var(--sp-5) 0}.lesson-number{padding-top:2px}.lesson-cover{display:none}.lesson-info h3{font-size:18px}.lesson-meta{gap:var(--sp-2);font-size:11px}.lesson-arrow{font-size:18px}.lesson-summary{font-size:13px}.browse-note{margin-top:var(--sp-6)}}
</style>
