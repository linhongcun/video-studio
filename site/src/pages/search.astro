---
// 站内搜索：Pagefind 在 astro build 之后生成静态索引（dist/pagefind/），只索引期数页标题、简介和正文
import BaseLayout from '../layouts/BaseLayout.astro';
import {BASE} from '../lib/episodes';
---
<BaseLayout title="搜索" current="search" description="搜索 IT小村全部内容的标题、简介和图文正文。">
  <div class="container wrap">
    <header class="page-intro"><p class="eyebrow">找到你想理解的问题</p><h1>搜索内容</h1><p>搜一个知识点，从标题、简介和图文中找到答案。</p></header>
    <div id="search" data-bundle={`${BASE}pagefind/`}></div>
    <noscript><p>搜索需要开启 JavaScript。也可以 <a href={`${BASE}learn/`}>按学习系列浏览</a>。</p></noscript>
    <p class="hint" data-fail hidden>搜索暂时无法加载。请稍后重试，或先 <a href={`${BASE}library/`}>浏览全部内容</a>。</p>
  </div>
</BaseLayout>
<script>
  const el = document.getElementById('search')!;
  const bundle = el.dataset.bundle!;
  const css = document.createElement('link'); css.rel = 'stylesheet'; css.href = `${bundle}pagefind-ui.css`; document.head.append(css);
  const s = document.createElement('script'); s.src = `${bundle}pagefind-ui.js`;
  s.onload = () => {
    // @ts-ignore
    new window.PagefindUI({element: '#search', bundlePath: bundle, showSubResults: true, showImages: true, resetStyles: false,
      translations: {placeholder: '例如：缓存、Agent、双指针', zero_results: '没有找到 “[SEARCH_TERM]” 相关的内容', clear_search: '清除', load_more: '加载更多', many_results: '找到 [COUNT] 条结果', one_result: '找到 1 条结果'}});
    const q = new URL(location.href).searchParams.get('q');
    const input = el.querySelector<HTMLInputElement>('input');
    if (input) { input.focus(); if (q) { input.value = q; input.dispatchEvent(new Event('input', {bubbles: true})); } }
  };
  s.onerror = () => { document.querySelector<HTMLElement>('[data-fail]')!.hidden = false; };
  document.body.append(s);
</script>
<style>
.wrap{max-width:var(--measure)}
.page-intro{padding-bottom:var(--sp-6)}
.hint{color:var(--c-text-2)}
#search{--pagefind-ui-primary:var(--c-primary);--pagefind-ui-text:var(--c-text);--pagefind-ui-background:var(--c-surface);--pagefind-ui-border:var(--c-border);--pagefind-ui-tag:var(--c-surface-2);--pagefind-ui-font:inherit;--pagefind-ui-border-radius:12px}
/* Pagefind injects these nodes after load, so only the search root is scoped. */
#search :global(mark){background:var(--c-highlight-bg);color:var(--c-highlight-text);border-radius:3px;padding:0 .08em;box-decoration-break:clone;-webkit-box-decoration-break:clone}
</style>
