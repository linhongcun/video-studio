---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EpisodeGrid from '../../components/EpisodeGrid.astro';
import {BASE, getEpisodes, getTags} from '../../lib/episodes';
import {getLearningTracks} from '../../lib/learning';
const episodes = getEpisodes();
const tracks = getLearningTracks();
const tags = getTags();
---
<BaseLayout title="全部内容" current="library" description="浏览 IT小村的技术与推理短片、图文，按系统原理、Agent 开发、算法可视化、设计模式、趣味推理、工程算法、系列和知识点筛选。">
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '全部内容'}]} />
    <header class="page-intro"><p class="eyebrow">THE LIBRARY</p><h1>找到你想弄懂的那个问题。</h1><p>短片、图文与代码，都在这里。你可以按方向浏览，也可以直接搜索一个知识点。</p><a class="text-link" href={`${BASE}search/`}>搜索标题与正文 <span aria-hidden="true">↗</span></a></header>
    <form class="catalog-controls" aria-label="筛选内容" hidden>
      <div class="filter-fields">
        <label>学习方向<select name="track"><option value="">全部方向</option>{tracks.map((track) => <option value={track.id}>{track.title}</option>)}</select></label>
        <label>系列<select name="series"><option value="">全部系列</option>{tracks.map((track) => <optgroup label={track.title}>{track.series.map((series) => <option value={series.id} data-track={track.id}>{series.title}</option>)}</optgroup>)}</select></label>
        <label>知识标签<select name="tag"><option value="">全部标签</option>{tags.map((tag) => <option value={tag.name}>{tag.name} · {tag.count}</option>)}</select></label>
        <label>排列方式<select name="sort"><option value="newest">最新发布</option><option value="learning">学习顺序</option></select></label>
      </div>
      <div class="filter-footer"><p id="catalog-count" role="status" aria-live="polite">共 {episodes.length} 篇内容</p><button class="reset" type="reset">重置筛选 <span aria-hidden="true">↺</span></button></div>
    </form>
    <noscript><p>可以<a href={`${BASE}learn/`}>按学习系列浏览</a>，或<a href={`${BASE}tags/`}>查看知识标签</a>。</p></noscript>
    <div class="library-heading"><h2>视频与图文</h2><a href={`${BASE}tags/`}>查看标签索引 →</a></div>
    <div id="library-grid"><EpisodeGrid episodes={episodes} /></div>
    <div class="catalog-empty surface" hidden><h2>这个组合暂时没有内容</h2><p>试试减少筛选条件，或搜索相关知识点。</p><button type="button" class="btn btn-primary" data-clear-filters>查看全部内容</button></div>
  </div>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('.catalog-controls')!;
  const grid = document.querySelector<HTMLUListElement>('#library-grid > ul')!;
  const count = document.getElementById('catalog-count')!;
  const empty = document.querySelector<HTMLElement>('.catalog-empty')!;
  const fields = Object.fromEntries(['track', 'series', 'tag', 'sort'].map((name) => [name, form.elements.namedItem(name) as HTMLSelectElement]));
  const rows = [...grid.children].map((li, index) => ({li: li as HTMLElement, card: li.querySelector<HTMLElement>('[data-series]')!, index}));
  const valid = (name: string, value: string) => [...fields[name].options].some((o) => o.value === value) ? value : name === 'sort' ? 'newest' : '';
  const syncSeries = () => {
    [...fields.series.options].forEach((option) => { option.disabled = !!option.value && !!fields.track.value && option.dataset.track !== fields.track.value; });
    if (fields.series.selectedOptions[0]?.disabled) fields.series.value = '';
  };
  const apply = (push: boolean) => {
    syncSeries();
    const values = {track: fields.track.value, series: fields.series.value, tag: fields.tag.value, sort: fields.sort.value};
    const sorted = [...rows].sort((a, b) => values.sort === 'learning' ? Number(a.card.dataset.rank) - Number(b.card.dataset.rank) : a.index - b.index);
    let visible = 0;
    for (const row of sorted) {
      const data = row.card.dataset;
      row.li.hidden = !!((values.track && data.track !== values.track) || (values.series && data.series !== values.series) || (values.tag && !data.tags?.split('|').includes(values.tag)));
      if (!row.li.hidden) visible++;
      grid.append(row.li);
    }
    count.textContent = visible === rows.length ? `共 ${visible} 篇内容` : `显示 ${visible} / ${rows.length} 篇内容`;
    empty.hidden = visible !== 0;
    if (push) {
      const url = new URL(location.href);
      Object.entries(values).forEach(([key, value]) => value && !(key === 'sort' && value === 'newest') ? url.searchParams.set(key, value) : url.searchParams.delete(key));
      history.pushState(null, '', url);
    }
  };
  const readUrl = () => {
    const params = new URLSearchParams(location.search);
    if (params.get('tag') === '全局唯一ID') params.set('tag', '分布式ID');
    Object.keys(fields).forEach((key) => { fields[key].value = valid(key, params.get(key) ?? ''); });
    if (fields.series.value && !fields.track.value) fields.track.value = fields.series.selectedOptions[0].dataset.track ?? '';
    apply(false);
  };
  form.hidden = false;
  form.addEventListener('submit', (event) => { event.preventDefault(); apply(true); });
  form.addEventListener('change', () => apply(true));
  const reset = () => { Object.keys(fields).forEach((key) => { fields[key].value = key === 'sort' ? 'newest' : ''; }); apply(true); };
  form.addEventListener('reset', (event) => { event.preventDefault(); reset(); });
  document.querySelector('[data-clear-filters]')!.addEventListener('click', reset);
  window.addEventListener('popstate', readUrl);
  readUrl();
</script>
<style>
.page-intro>.text-link{margin-top:16px}.catalog-controls{padding:24px 28px;border:1px solid var(--c-border);border-radius:14px;background:var(--c-surface);margin:0 0 36px}.filter-fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}.filter-fields label{display:flex;flex-direction:column;gap:9px;font-size:11px;font-weight:600;color:var(--c-text-2);letter-spacing:.02em}.filter-fields select{width:100%;min-height:44px;padding:8px 30px 8px 12px;background:var(--c-bg);color:var(--c-text);border:1px solid var(--c-border);border-radius:6px;font:inherit;font-size:13px;cursor:pointer}.filter-footer{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:20px;padding-top:16px;border-top:1px solid var(--c-border);font-size:11px;color:var(--c-text-2)}.filter-footer p{margin:0}.reset{padding:5px 0;min-height:32px;background:none;border:0;color:var(--c-primary);font:inherit;cursor:pointer}.reset span{margin-left:8px}.library-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}.library-heading h2{font-size:20px;font-weight:600;margin:0}.library-heading a{font-size:12px;color:var(--c-text-2);text-decoration:none}.catalog-empty{padding:48px;text-align:center}.catalog-empty h2{font-size:22px}.catalog-empty p{color:var(--c-text-2);font-size:14px}
@media(max-width:767px){.catalog-controls{padding:20px;margin-bottom:28px}.filter-fields{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.filter-fields select{font-size:12px}.library-heading h2{font-size:19px}.library-heading a{font-size:11px}.catalog-empty{padding:28px}}
</style>
