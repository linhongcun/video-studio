---
import BaseLayout from '../layouts/BaseLayout.astro';
import {REPO, BASE} from '../lib/episodes';
import {getLearningTracks} from '../lib/learning';
const tracks = getLearningTracks();
---
<BaseLayout title="关于" current="about" description="IT小村用技术动画短片与图文讲解，把系统原理、Agent 开发、算法与设计模式中的关键过程一步步讲清楚。">
  <div class="container about">
    <header class="page-intro">
      <p class="eyebrow">关于 IT小村</p>
      <h1>把抽象的原理，<br />变成看得懂的过程。</h1>
      <p>一个问题，一段短片，一篇图文。从请求怎样抵达服务器、Agent 怎样调用工具，到算法为什么这样做、代码怎样应对需求变化，顺着过程看清每一步。</p>
    </header>
    <section class="focus" aria-labelledby="focus-title">
      <h2 id="focus-title">在这里，可以学什么</h2>
      <div class="areas">
        {tracks.map((track) => <a href={track.href}><span class="num">{track.number}</span><h3>{track.title}</h3><p>{track.description}</p><span class="text-link">进入学习方向 →</span></a>)}
      </div>
    </section>
    <section class="method" aria-labelledby="method-title">
      <div><p class="eyebrow">我们的讲解方式</p><h2 id="method-title">先看见过程，<br />再理解依据。</h2></div>
      <div class="method-copy">
        <p>短片先聚焦一个问题，用连续动画展示发生了什么。图文再补足概念、前置知识、适用边界和参考资料，方便暂停、回看与查找。</p>
        <p>我们优先查阅协议、官方文档和原始工程资料。教学示例、实现选择与实际结论分别说明；内容有修正时，会记录在更新日志中。</p>
        <p>动画由代码制作，脚本、分镜和实现随项目公开。对制作方法感兴趣，可以从每期文章末尾的“幕后”进入源码。</p>
        <a class="text-link" href={REPO} rel="noopener" target="_blank">查看 GitHub 项目 ↗</a>
      </div>
    </section>
    <section class="start surface" aria-labelledby="start-title"><div><h2 id="start-title">从你正在好奇的问题开始。</h2><p>按系列循序学习，也可以直接搜索一个知识点。</p></div><div class="start-actions"><a class="btn btn-primary" href={`${BASE}learn/`}>选择学习系列 →</a><a class="btn btn-ghost" href={`${BASE}search/`}>搜索内容</a></div></section>
  </div>
</BaseLayout>
<style>
.about{max-width:1120px}.page-intro{padding-bottom:var(--sp-8);max-width:800px}.page-intro h1{font-size:clamp(34px,4.4vw,54px);line-height:1.3;letter-spacing:-.045em;margin-bottom:var(--sp-5)}.page-intro>p:last-child{max-width:620px;font-size:17px}
.focus{border-top:1px solid var(--c-border);padding:var(--sp-7) 0 var(--sp-8)}h2{font-size:var(--fs-h2);letter-spacing:-.03em;line-height:1.45;margin:0 0 var(--sp-5)}
.areas{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--sp-6)}.areas>a{display:flex;flex-direction:column;color:inherit;text-decoration:none}.areas>a>.num{font-size:11px;font-family:var(--font-mono);color:var(--c-primary)}.areas h3{font-size:20px;margin:var(--sp-4) 0 var(--sp-3)}.areas p{font-size:14px;color:var(--c-text-2);line-height:1.85;margin:0 0 var(--sp-4);flex:1}.areas>a:hover .text-link{text-decoration:underline}
.method{display:grid;grid-template-columns:1fr 1.5fr;gap:var(--sp-8);border-top:1px solid var(--c-border);padding:var(--sp-8) 0}.method-copy p{margin:0 0 var(--sp-5);color:var(--c-text-2)}
.start{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-6);padding:var(--sp-6)}.start h2{font-size:21px;margin:0 0 var(--sp-2)}.start p{color:var(--c-text-2);font-size:14px;margin:0}.start-actions{display:flex;gap:var(--sp-3);flex-wrap:wrap;flex:none}
@media (max-width:1099px){.areas{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-7)}}
@media (max-width:900px){.start{align-items:flex-start;flex-direction:column}.method{gap:var(--sp-7)}}
@media (max-width:767px){.page-intro{padding-bottom:var(--sp-7)}.page-intro>p:last-child{font-size:16px}.areas{grid-template-columns:1fr;gap:var(--sp-6)}.areas>a{padding-bottom:var(--sp-5);border-bottom:1px solid var(--c-border)}.areas>a:last-child{border:0;padding-bottom:0}.areas h3{margin:var(--sp-2) 0}.areas p{margin-bottom:var(--sp-3)}.method{grid-template-columns:1fr;gap:var(--sp-4);padding:var(--sp-7) 0}.method h2 br{display:none}.method h2{margin-bottom:0}.start{padding:var(--sp-5)}}
</style>
