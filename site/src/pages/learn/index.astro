---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TrackMark from '../../components/TrackMark.astro';
import {BASE, epHref, seriesHref, fmtTime} from '../../lib/episodes';
import {getLearningTracks} from '../../lib/learning';
const tracks = getLearningTracks();
---
<BaseLayout title="学习系列" current="learn" description="选择系统原理、Agent 开发、算法可视化、设计模式、趣味推理、工程算法、消息队列或数据库，从入门短片开始，沿着清楚的课程目录继续学习。">
  <div class="container">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '学习系列'}]} />
    <header class="page-intro"><p class="eyebrow">LEARNING PATHS</p><h1>选一个方向，<br class="mobile-break" />从这里开始。</h1><p>每个方向独立学习。先用短片建立理解，再用图文、代码与资料把细节补齐。</p></header>
    <nav class="series-directory" aria-label="系列直达"><span class="directory-label">系列直达</span><div class="series-jumps">{tracks.flatMap((track) => track.series).map((series) => <a href={seriesHref(series.id)}>{series.title}<span aria-hidden="true">↗</span></a>)}</div></nav>
    <div class="learning-tracks">{tracks.map((track) => <section class="learning-track" id={track.id} aria-labelledby={`${track.id}-title`}>
      <div class="track-overview"><div class="track-identity"><TrackMark id={track.id} /><span class="num">DIRECTION {track.number}</span></div><h2 id={`${track.id}-title`}>{track.title}</h2><p class="track-description">{track.description}</p><dl><div><dt>适合谁</dt><dd>{track.audience}</dd></div><div><dt>学到什么</dt><dd>{track.outcome}</dd></div></dl><a class="btn btn-primary" href={epHref(track.start.slug)}>从第一课开始 <span aria-hidden="true">↗</span></a><p class="published">已发布 {track.episodes.length} 篇 · {track.series.length} 个系列</p></div>
      <div class="track-curriculum"><div class="curriculum-head"><h3>学习目录</h3><span>按学习顺序排列</span></div>{track.series.map((series, i) => <div class="chapter"><a class="chapter-heading" href={seriesHref(series.id)}><span class="chapter-number num">{String(i + 1).padStart(2, '0')}</span><div><h4>{series.title}</h4><p>{series.description}</p></div><span class="chapter-count">{series.episodes.length} 篇 <span aria-hidden="true">↗</span></span></a><ol class="chapter-lessons">{series.episodes.map((e) => <li><a href={epHref(e.slug)}>{e.title}<span class="num">{fmtTime(e.duration)} <span aria-hidden="true">→</span></span></a></li>)}</ol></div>)}
      {track.id === 'agent' && <aside class="planned"><strong>后续规划</strong><p>工具调用、上下文、RAG、MCP 与可靠执行等主题将逐步展开。已发布内容以上方目录为准。</p></aside>}
      {track.id === 'algorithms' && <aside class="planned"><strong>从题目走向方法</strong><p>每一题都保留题号、推理过程与完整代码，后续题目随内容更新加入目录。</p></aside>}</div>
    </section>)}</div>
    <p class="browse-note">想直接找一个知识点？<a href={`${BASE}search/`}>搜索内容</a>，或<a href={`${BASE}library/`}>浏览全部视频与图文</a>。</p>
  </div>
</BaseLayout>
<style>
.mobile-break{display:none}.series-directory{position:sticky;top:calc(var(--header-h) + 8px);z-index:20;display:flex;align-items:center;gap:18px;padding:12px 16px;margin:0 0 32px;border:1px solid var(--c-border);border-radius:12px;background:var(--c-surface);box-shadow:var(--shadow-1)}.directory-label{flex:none;font-size:12px;font-weight:600;color:var(--c-text-2)}.series-jumps{display:flex;gap:8px;overflow-x:auto;padding:3px;scrollbar-width:thin}.series-jumps a{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;padding:6px 12px;border:1px solid var(--c-border);border-radius:8px;color:var(--c-text);text-decoration:none;font-size:13px}.series-jumps a:hover{border-color:var(--c-primary);color:var(--c-primary)}.series-jumps a>span{color:var(--c-primary)}
.learning-tracks{display:grid;gap:40px}.learning-track{display:grid;grid-template-columns:1fr 1.5fr;gap:64px;padding:40px;border:1px solid var(--c-border);border-radius:20px;background:var(--c-surface);scroll-margin-top:calc(var(--header-h) + 100px)}.track-overview{min-width:0}.track-identity{display:flex;align-items:center;gap:16px;color:var(--c-primary);font-size:10px;letter-spacing:.12em}.track-identity :global(svg){width:44px;height:44px}.track-overview h2{font-size:32px;line-height:1.4;margin:22px 0 16px;letter-spacing:-.02em}.track-description{font-size:15px;color:var(--c-text-2);line-height:1.9;margin:0 0 28px}dl{margin:0 0 28px}dl>div{margin-bottom:20px}dt{font-size:11px;font-weight:600;color:var(--c-text);margin-bottom:6px}dd{margin:0;font-size:13px;line-height:1.8;color:var(--c-text-2)}.published{font-size:11px;color:var(--c-text-2);margin:12px 0 0}
.curriculum-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:8px;padding-bottom:18px;border-bottom:1px solid var(--c-border)}.curriculum-head h3{font-size:14px;margin:0}.curriculum-head>span{font-size:10px;color:var(--c-text-2)}.chapter{padding:22px 0;border-bottom:1px solid var(--c-border)}.chapter-heading{display:flex;align-items:flex-start;gap:14px;text-decoration:none;color:var(--c-text)}.chapter-number{font-size:11px;color:var(--c-primary);padding-top:5px}.chapter-heading h4{margin:0 0 4px;font-size:17px;line-height:1.5}.chapter-heading p{font-size:12px;color:var(--c-text-2);margin:0;line-height:1.8}.chapter-count{margin-left:auto;white-space:nowrap;font-size:10px;padding-top:5px;color:var(--c-text-2)}.chapter-lessons{list-style:none;margin:12px 0 0 30px;padding:0}.chapter-lessons a{display:flex;align-items:baseline;gap:16px;justify-content:space-between;padding:9px 0;color:var(--c-text-2);font-size:12px;text-decoration:none;line-height:1.7}.chapter-lessons a:hover{color:var(--c-primary)}.chapter-lessons .num{white-space:nowrap;font-size:10px;color:var(--c-muted)}.chapter-lessons .num>span{margin-left:8px}.planned{padding:20px;margin-top:24px;background:var(--c-surface-2);border-radius:8px}.planned strong{font-size:12px}.planned p{font-size:12px;color:var(--c-text-2);margin:6px 0 0}.browse-note{font-size:14px;margin:40px 0 0;color:var(--c-text-2);text-align:center}
@media(max-width:1000px){.learning-track{padding:32px;gap:32px;grid-template-columns:1fr 1.3fr}}
@media(min-width:768px){.track-overview{position:sticky;top:calc(var(--header-h) + 28px);align-self:start}}
@media(max-width:767px){.mobile-break{display:block}.series-directory{gap:10px;padding:8px;margin-bottom:24px}.directory-label{font-size:11px}.series-jumps a{padding:6px 10px;font-size:12px}.learning-track{grid-template-columns:1fr;padding:24px;gap:32px;border-radius:14px}.learning-tracks{gap:24px}.track-overview h2{font-size:28px;margin-top:16px}.track-description{font-size:14px}.track-curriculum{min-width:0}.chapter-heading{gap:10px}.chapter-heading h4{font-size:16px}.chapter-lessons{margin-left:0}.chapter-lessons a{font-size:12px;gap:12px}.browse-note{text-align:left}}
</style>
