---
import BaseLayout from '../layouts/BaseLayout.astro';
import {BASE} from '../lib/episodes';
---
<BaseLayout title="页面未找到" description="这个地址没有对应的页面。你可以返回首页、浏览学习内容，或搜索想了解的内容。" noIndex>
  <div class="container not-found">
    <p class="eyebrow">404 · 页面未找到</p>
    <h1>这条路暂时走不通。</h1>
    <p class="description">页面可能已移动，或者地址有误。换个入口，继续寻找你想理解的问题。</p>
    <nav class="recovery-links" aria-label="继续浏览">
      <a class="btn btn-primary" href={BASE}>返回首页</a>
      <a class="btn btn-ghost" href={`${BASE}library/`}>学习内容</a>
    </nav>
    <form action={`${BASE}search/`} method="get" role="search">
      <label for="missing-page-search">搜索你想了解的知识点</label>
      <div class="search-controls"><input id="missing-page-search" name="q" type="search" placeholder="例如：缓存、消息队列、双指针" /><button class="btn btn-primary" type="submit">搜索内容</button></div>
    </form>
  </div>
</BaseLayout>
<style>
.not-found{max-width:760px;padding-block:clamp(48px,10vw,120px)}h1{font-size:clamp(30px,5vw,48px);line-height:1.35;margin:0 0 20px;letter-spacing:-.03em}.description{color:var(--c-text-2);margin:0;max-width:38em}.recovery-links{display:flex;flex-wrap:wrap;gap:12px;margin:30px 0 48px}form{padding:24px;border:1px solid var(--c-border);border-radius:var(--r-lg);background:var(--c-surface)}label{display:block;font-size:14px;font-weight:600;margin-bottom:12px}.search-controls{display:flex;gap:12px}input{min-width:0;flex:1;width:100%;border:1px solid var(--c-border);border-radius:var(--r-sm);padding:10px 12px;background:var(--c-bg);color:var(--c-text);font-size:14px}input::placeholder{color:var(--c-muted)}button{flex:none}@media(max-width:480px){.search-controls{flex-direction:column}.recovery-links{gap:8px}.recovery-links .btn{padding-inline:14px}form{padding:20px}}
</style>
