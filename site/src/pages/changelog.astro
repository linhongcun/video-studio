---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import {BASE, REPO, getEpisodes, epHref, epLabel, compareLessons} from '../lib/episodes';
import {getReleases, episodesForRelease} from '../lib/releases';
const releases = await getReleases();
const episodes = [...getEpisodes()].sort(compareLessons);
// 正文只做最小化渲染：转义后把 `代码` 与 PR #n 变成样式/链接
const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'})[c]!);
const render = (s: string) => esc(s)
  .replace(/`([^`]+)`/g, '<code>$1</code>')
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  .replace(/PR #(\d+)/g, `<a href="${REPO}/pull/$1" rel="noopener" target="_blank">PR #$1</a>`)
  .split(/\n{2,}/).map((p) => `<p>${p.replace(/\n/g, '<br>')}</p>`).join('');
---
<BaseLayout title="更新日志" current="changelog" description="Video Studio 每次发布新增和修正了哪些期数">
  <div class="container wrap">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '更新日志'}]} />
    <h1>更新日志</h1>
    <p class="lead">每次发布新增或修正了哪些期数（时间为北京时间）。完整记录见 <a href={`${REPO}/releases`} rel="noopener" target="_blank">GitHub Releases ↗</a></p>
    {!releases && <p class="fallback">暂时没拿到发布记录，请直接查看 <a href={`${REPO}/releases`} rel="noopener" target="_blank">GitHub Releases ↗</a></p>}
    {releases && (
      <ol class="rl" role="list">
        {releases.map((r) => (
          <li>
            <div class="hd">
              <a class="tag num" href={r.url} rel="noopener" target="_blank">{r.tag}</a>
              <span class={`k k-${r.kind === '新增' ? 'add' : r.kind === '修正' ? 'fix' : 'upd'}`}>{r.kind}</span>
              <time class="num">{r.date}</time>
            </div>
            {episodesForRelease(r, episodes).length > 0 && (
              <p class="eps">{episodesForRelease(r, episodes).map((e) => <a href={epHref(e.slug)}>{epLabel(e)} {e.title}</a>)}</p>
            )}
            {r.body && <div class="body" set:html={render(r.body)} />}
          </li>
        ))}
      </ol>
    )}
  </div>
</BaseLayout>
<style>
.wrap{max-width:var(--measure)}
h1{font-size:var(--fs-h1);margin:0 0 var(--sp-2)}
.lead{color:var(--c-text-2);margin:0 0 var(--sp-6)}
.fallback{padding:var(--sp-4);border:1px dashed var(--c-border);border-radius:var(--r-md)}
.rl{list-style:none;margin:0;padding:0;border-left:2px solid var(--c-border)}
.rl>li{position:relative;padding:0 0 var(--sp-6) var(--sp-5)}
.rl>li::before{content:'';position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--c-bg);border:2px solid var(--c-primary)}
.hd{display:flex;align-items:center;gap:var(--sp-2);flex-wrap:wrap}
.tag{font-family:var(--font-mono);font-weight:700;color:var(--c-text)}
.k{font-size:var(--fs-xs);padding:1px 8px;border-radius:var(--r-full);border:1px solid var(--c-border)}
.k-add{background:var(--c-primary);color:var(--c-on-primary);border-color:var(--c-primary)}
.k-fix{color:var(--c-accent);border-color:var(--c-accent)}
time{color:var(--c-text-2);font-size:var(--fs-small)}
.eps{display:flex;flex-wrap:wrap;gap:var(--sp-2);margin:var(--sp-2) 0 0;font-size:var(--fs-small)}
.eps a{padding:1px 10px;border-radius:var(--r-full);background:var(--c-surface-2);color:var(--c-text);text-decoration:none}
.body{color:var(--c-text-2);font-size:var(--fs-small);line-height:1.7;margin-top:var(--sp-2);overflow-wrap:anywhere}
.body :global(p){margin:0 0 var(--sp-2)}
.body :global(code){background:var(--c-surface-2);padding:0 4px;border-radius:var(--r-sm)}
</style>
