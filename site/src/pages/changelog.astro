---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ReleaseList from '../components/ReleaseList.astro';
import {BASE, REPO, getEpisodes, compareLessons} from '../lib/episodes';
import {getReleases, type Release} from '../lib/releases';
const releases = await getReleases();
const episodes = [...getEpisodes({includeArchived: true})].sort(compareLessons);
const recent = releases?.slice(0, 5) ?? [];
const older = new Map<string, Release[]>();
for (const release of releases?.slice(5) ?? []) {
  const month = release.date.slice(0, 7);
  older.set(month, [...(older.get(month) ?? []), release]);
}
---
<BaseLayout title="更新日志" current="changelog" description="IT小村的内容更新、讲解修订与站点改进记录。">
  <div class="container wrap">
    <Breadcrumb items={[{label: '首页', href: BASE}, {label: '更新日志'}]} />
    <header class="page-intro"><p class="eyebrow">持续完善，每一次都有记录</p><h1>更新日志</h1><p class="lead">新增内容、讲解修订与站点改进。日期为北京时间，完整记录见 <a href={`${REPO}/releases`} rel="noopener" target="_blank">GitHub Releases ↗</a>。</p></header>
    {!releases && <p class="fallback">暂时没拿到发布记录，请直接查看 <a href={`${REPO}/releases`} rel="noopener" target="_blank">GitHub Releases ↗</a></p>}
    {releases && (
      <>
        <section aria-labelledby="recent-releases">
          <h2 id="recent-releases">最近更新</h2>
          <ReleaseList releases={recent} episodes={episodes} />
        </section>
        {older.size > 0 && (
          <section aria-labelledby="older-releases">
            <h2 id="older-releases">更早的更新</h2>
            {[...older].map(([month, entries]) => (
              <details class="archive">
                <summary>{month.replace('-', ' 年 ')} 月 · 更早的 {entries.length} 个版本</summary>
                <ReleaseList releases={entries} episodes={episodes} />
              </details>
            ))}
          </section>
        )}
      </>
    )}
  </div>
</BaseLayout>
<style>
.wrap{max-width:var(--measure)}
h1{font-size:var(--fs-h1);margin:0 0 var(--sp-2)}
h2{font-size:var(--fs-h2);margin:0 0 var(--sp-5)}
.lead{color:var(--c-text-2);margin:0 0 var(--sp-6)}
.fallback{padding:var(--sp-4);border:1px dashed var(--c-border);border-radius:var(--r-md)}
.archive{border:1px solid var(--c-border);border-radius:var(--r-md);padding:var(--sp-4);margin-bottom:var(--sp-4)}
.archive summary{cursor:pointer;font-weight:600}
.archive[open] summary{margin-bottom:var(--sp-5)}
.archive summary:focus-visible{outline:2px solid var(--c-primary);outline-offset:4px}
</style>
