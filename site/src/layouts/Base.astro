---
const {title} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title ? `${title} · Video Studio` : 'Video Studio 技术科普'}</title>
<style is:global>
:root{--bg:#0B1020;--panel:#111827;--p:#22D3EE;--s:#3B82F6;--ok:#22C55E;--t:#E5E7EB;--m:#9CA3AF}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--t);font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif;line-height:1.75}
a{color:var(--p)}
code,pre{font-family:"JetBrains Mono","DejaVu Sans Mono",ui-monospace,monospace}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header.top{border-bottom:1px solid #1F2A44}
header.top .wrap{display:flex;align-items:center;height:56px}
header.top a{color:var(--t);text-decoration:none;font-weight:700}
footer{color:#6B7280;font-size:13px;text-align:center;padding:40px 0}
</style>
</head>
<body>
<header class="top"><div class="wrap"><a href={base}>Video Studio</a></div></header>
<slot />
<footer>© 2026 Video Studio · v0.2.0</footer>
</body>
</html>
