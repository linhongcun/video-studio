---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {VERSION, BASE} from '../lib/episodes';
const {title, description = '用技术动画短片与图文讲解，理解系统原理、Agent 开发、算法与设计模式。IT小村，把每一步讲清楚。', ogImage, current = '', ogType = 'website', jsonLd, noIndex = false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const full = title ? `${title} · IT小村` : 'IT小村 · 技术可视化学习站';
const og = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN" data-pagefind-ignore={noIndex ? 'all' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${BASE}favicon-32.png`} />
  <link rel="icon" type="image/svg+xml" sizes="any" href={`${BASE}favicon.svg?v=code-village`} />
  <link rel="apple-touch-icon" sizes="180x180" href={`${BASE}apple-touch-icon.png`} />
  <meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#F5F7F6" media="(prefers-color-scheme: light)" />
  <!-- 首屏前写入 data-theme，防止主题闪烁（必须在样式之前、同步执行） -->
  <script is:inline>
    (function () {
      var d = document.documentElement, pref = 'system';
      try { pref = localStorage.getItem('vs:theme') || 'system'; } catch (e) {}
      if (pref !== 'light' && pref !== 'dark') pref = 'system';
      var mq = window.matchMedia('(prefers-color-scheme: light)');
      var apply = function () {
        var t = pref === 'system' ? (mq.matches ? 'light' : 'dark') : pref;
        d.setAttribute('data-theme', t); d.setAttribute('data-theme-pref', pref);
        var m = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < m.length; i++) m[i].setAttribute('content', t === 'light' ? '#F5F7F6' : '#0F172A');
      };
      window.__vsTheme = {
        get: function () { return pref; },
        set: function (p) { pref = p; try { p === 'system' ? localStorage.removeItem('vs:theme') : localStorage.setItem('vs:theme', p); } catch (e) {} apply(); },
      };
      mq.addEventListener && mq.addEventListener('change', function () { if (pref === 'system') apply(); });
      apply();
    })();
  </script>
  <title>{full}</title>
  {noIndex && <meta name="robots" content="noindex,follow" />}
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="IT小村" />
  <meta property="og:locale" content="zh_CN" />
  {og && <meta property="og:image" content={og} />}
  <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  {og && <meta name="twitter:image" content={og} />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="IT小村 新片订阅" href={`${BASE}rss.xml`} />
  <link rel="sitemap" href={`${BASE}sitemap-index.xml`} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <SiteHeader current={current} />
  <main id="main" tabindex="-1"><slot /></main>
  <SiteFooter version={VERSION} />
</body>
</html>
