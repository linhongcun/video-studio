---
import EpisodeCard from './EpisodeCard.astro';
const {episodes} = Astro.props;
---
<ul class="grid" role="list">{episodes.map((e) => <li><EpisodeCard e={e} /></li>)}</ul>
<style>
.grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr;gap:var(--sp-4)}
.grid li{display:flex}.grid li>:global(*){flex:1}
@media (min-width:768px){.grid{grid-template-columns:repeat(2,1fr);gap:var(--sp-5)}}
@media (min-width:1280px){.grid{grid-template-columns:repeat(3,1fr)}}
</style>
