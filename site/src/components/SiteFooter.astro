---
import {BASE, REPO} from '../lib/episodes';
const {version} = Astro.props;
---
<footer class="ftr">
  <div class="container in">
    <span>Video Studio · 用代码拍科普</span>
    <span><a href={REPO} rel="noopener" target="_blank">GitHub ↗</a> · <a href={`${BASE}about/`}>关于</a> · <a href={`${BASE}changelog/`}>更新日志</a> · <a href={`${BASE}rss.xml`}>RSS 订阅</a></span>
    <span class="num">v{version} © 2026</span>
    <span class="bgm">背景音乐："Wallpaper" Kevin MacLeod (incompetech.com) · Licensed under Creative Commons: By Attribution 4.0 License · <a href="http://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">http://creativecommons.org/licenses/by/4.0/</a></span>
  </div>
</footer>
<style>
.ftr{margin-top:var(--sp-9);border-top:1px solid var(--c-border);color:var(--c-text-2);font-size:var(--fs-small)}
.in{display:flex;justify-content:space-between;gap:var(--sp-4);padding:var(--sp-6) 0;flex-wrap:wrap}
.ftr a{color:var(--c-text-2)}
.bgm{flex-basis:100%;overflow-wrap:anywhere}
@media (max-width:767px){.in{flex-direction:column;gap:var(--sp-2)}.ftr{margin-top:var(--sp-7)}}
</style>
