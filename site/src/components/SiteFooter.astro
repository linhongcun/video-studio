---
import {BASE, REPO} from '../lib/episodes';
const {version} = Astro.props;
---
<footer class="ftr">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand"><a href={BASE}>IT小村<span aria-hidden="true">.</span></a><p>用短片理解机制，<br />用图文看清细节。</p></div>
      <nav aria-label="页脚探索导航"><span class="footer-label">继续探索</span><a href={`${BASE}learn/`}>学习系列</a><a href={`${BASE}library/`}>全部内容</a><a href={`${BASE}about/`}>关于 IT小村</a></nav>
      <nav aria-label="页脚资源导航"><span class="footer-label">内容与更新</span><a href={`${BASE}rss.xml`}>RSS 订阅 ↗</a><a href={`${BASE}changelog/`}>更新日志</a><a href={REPO} rel="noopener" target="_blank">GitHub 源码 ↗</a></nav>
    </div>
    <div class="footer-bottom"><span>© 2026 IT小村 · 用代码拍科普</span><span class="num">v{version}</span></div>
    <p class="bgm">背景音乐：Wallpaper · Kevin MacLeod（incompetech.com）· <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC BY 4.0</a></p>
  </div>
</footer>
<style>
.ftr{margin-top:var(--sp-9);border-top:1px solid var(--c-border);font-size:var(--fs-small);color:var(--c-text-2)}
.footer-main{display:grid;grid-template-columns:minmax(0,2fr) repeat(2,minmax(0,1fr));gap:var(--sp-7);padding:var(--sp-7) 0}
.footer-brand>a{font-size:24px;font-weight:750;letter-spacing:-.04em;text-decoration:none;color:var(--c-text)}.footer-brand>a span{color:var(--c-primary);margin-left:2px}
.footer-brand p{margin:var(--sp-3) 0 0;font-size:13px;line-height:1.85;color:var(--c-text-2)}
nav{display:flex;flex-direction:column;align-items:flex-start;gap:var(--sp-2)}.footer-label{font-size:11px;font-weight:600;letter-spacing:.08em;color:var(--c-muted);margin-bottom:var(--sp-2)}
nav a{color:var(--c-text-2);text-decoration:none;font-size:13px;min-height:28px}nav a:hover{color:var(--c-primary);text-decoration:underline}
.footer-bottom{display:flex;justify-content:space-between;gap:var(--sp-4);padding:var(--sp-5) 0 var(--sp-3);border-top:1px solid var(--c-border);font-size:11px}
.footer-bottom .num{font-family:var(--font-mono);color:var(--c-muted)}
.bgm{margin:0;padding:0 0 var(--sp-5);font-size:10px;line-height:1.8;color:var(--c-muted)}.bgm a{color:inherit}
@media (max-width:767px){.ftr{margin-top:var(--sp-8)}.footer-main{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-6);padding:var(--sp-6) 0}.footer-brand{grid-column:1/-1}.footer-brand p br{display:none}.footer-brand p{margin-top:var(--sp-2)}.footer-bottom{flex-wrap:wrap}}
</style>
