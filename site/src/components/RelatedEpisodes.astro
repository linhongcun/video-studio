---
import {epHref} from '../lib/episodes';
const {items} = Astro.props;
---
{items.length > 0 && (
  <aside class="rel" aria-label="相关版本">
    {items.map((r) => r.published ? (
      <a class="rc" href={epHref(r.slug)}><small>{r.label || '相关'} →</small><strong>{r.title}</strong><span>{r.summary}</span></a>
    ) : (
      <div class="rc soon"><small>{r.label || '相关'} · 制作中</small><strong>{r.title}</strong><span>即将上线，敬请期待</span></div>
    ))}
  </aside>
)}
<style>
.rel{display:grid;gap:var(--sp-3);margin:var(--sp-5) 0 0}
.rc{display:flex;flex-direction:column;gap:2px;padding:var(--sp-3) var(--sp-4);background:var(--c-surface);border:1px solid var(--c-border);border-left:3px solid var(--c-secondary);border-radius:var(--r-md);color:var(--c-text);text-decoration:none}
a.rc:hover{border-color:var(--c-primary-a40);filter:none}
.rc small{color:var(--c-primary);font-size:var(--fs-xs);font-weight:600}
.rc strong{font-size:var(--fs-small)}
.rc span{color:var(--c-text-2);font-size:var(--fs-xs)}
.soon{border-left-color:var(--c-muted)}.soon small{color:var(--c-text-2)}
</style>
