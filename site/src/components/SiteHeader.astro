---
import {BASE, REPO} from '../lib/episodes';
import ThemeToggle from './ThemeToggle.astro';
const {current = ''} = Astro.props;
const nav = [
  {id: 'home', label: '首页', href: BASE},
  {id: 'learn', label: '学习系列', href: `${BASE}learn/`},
  {id: 'library', label: '全部内容', href: `${BASE}library/`},
  {id: 'about', label: '关于', href: `${BASE}about/`},
];
---
<header class="hdr">
  <div class="container in">
    <a class="logo" href={BASE} aria-label="IT小村 首页">
      <img class="brand-mark" src={`${BASE}favicon.svg?v=code-village`} width="40" height="40" alt="" aria-hidden="true" />
      <span class="brand-name">IT小村<small>技术可视化</small></span>
    </a>
    <nav class="nav" aria-label="主导航">
      {nav.map((n) => <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="right">
      <a class="icon-button github-link" href={REPO} target="_blank" rel="noopener" aria-label="GitHub 项目仓库（在新标签页打开）" title="GitHub 项目仓库（在新标签页打开）"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path stroke="none" d="M12 .75a11.25 11.25 0 0 0-3.558 21.922c.563.104.769-.244.769-.542 0-.267-.01-.974-.015-1.912-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.686.078-.686 1.13.08 1.725 1.16 1.725 1.16 1.004 1.72 2.634 1.223 3.276.935.102-.727.393-1.223.715-1.504-2.499-.284-5.126-1.25-5.126-5.565 0-1.229.44-2.232 1.16-3.02-.116-.284-.503-1.429.11-2.978 0 0 .944-.302 3.094 1.154A10.79 10.79 0 0 1 12 6.184c.955.004 1.917.13 2.813.378 2.148-1.456 3.09-1.154 3.09-1.154.615 1.549.228 2.694.112 2.978.722.788 1.159 1.791 1.159 3.02 0 4.327-2.631 5.278-5.138 5.557.404.35.766 1.043.766 2.1 0 1.517-.014 2.741-.014 3.113 0 .3.203.65.774.54A11.25 11.25 0 0 0 12 .75Z"/></svg></a>
      <a class="icon-button search-link" href={`${BASE}search/`} aria-label="搜索内容" aria-current={current === 'search' ? 'page' : undefined} title="搜索内容"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></a>
      <ThemeToggle />
      <button class="burger icon-button" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="drawer"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
</header>
<dialog id="drawer" class="drawer" aria-label="主菜单">
  <div class="drawer-head"><span>探索 IT小村</span><button class="close icon-button" type="button" aria-label="关闭菜单" autofocus><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <nav aria-label="移动端主导航">{nav.map((n, i) => <a href={n.href} aria-current={current === n.id ? 'page' : undefined}><span class="num">0{i + 1}</span>{n.label}<span aria-hidden="true">↗</span></a>)}<a href={REPO} target="_blank" rel="noopener" aria-label="GitHub 仓库（在新标签页打开）"><span class="num">0{nav.length + 1}</span>GitHub 仓库<span aria-hidden="true">↗</span></a></nav>
  <p>用短片理解机制，用图文看清细节。</p>
</dialog>
<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  const drawer = document.getElementById('drawer') as HTMLDialogElement;
  let previousOverflow = '';
  burger.addEventListener('click', () => {
    previousOverflow = document.body.style.overflow;
    drawer.showModal();
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  });
  drawer.querySelector('.close')!.addEventListener('click', () => drawer.close());
  drawer.addEventListener('click', (event) => { if (event.target === drawer) {
    const box = drawer.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) drawer.close();
  }});
  drawer.addEventListener('close', () => {
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = previousOverflow;
    burger.focus();
  });
  matchMedia('(min-width: 768px)').addEventListener('change', (event) => { if (event.matches && drawer.open) drawer.close(); });
</script>
<style>
.hdr{position:sticky;top:0;z-index:50;height:var(--header-h);background:var(--c-header-bg);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid var(--c-border)}
.in{height:100%;display:flex;align-items:center;justify-content:space-between;gap:var(--sp-5)}
.logo{display:inline-flex;align-items:center;gap:10px;color:var(--c-text);text-decoration:none;flex:none}
.logo:hover{filter:none}.brand-mark{display:block;flex:none;width:40px;height:40px}
.brand-name{font-size:21px;font-weight:750;letter-spacing:-.04em;line-height:1.2}
.brand-name small{display:block;font-size:10px;color:var(--c-text-2);font-weight:500;letter-spacing:.16em;margin-top:4px}
.nav{display:flex;align-items:center;gap:var(--sp-6)}
.nav a{position:relative;display:flex;align-items:center;min-height:44px;color:var(--c-text-2);font-size:14px;font-weight:550;text-decoration:none;white-space:nowrap}
.nav a:hover{color:var(--c-text);filter:none}
.nav a[aria-current="page"]{color:var(--c-text)}
.nav a[aria-current="page"]::after{content:'';position:absolute;bottom:2px;left:50%;width:4px;height:4px;border-radius:50%;background:var(--c-primary);transform:translateX(-50%)}
.right{display:flex;align-items:center;gap:4px}.search-link[aria-current]{color:var(--c-primary)}
.burger{display:none}
.drawer{width:calc(100% - 32px);max-width:440px;margin:16px auto auto;padding:var(--sp-5);color:var(--c-text);background:var(--c-bg);border:1px solid var(--c-border);border-radius:var(--r-lg);box-shadow:var(--shadow-2)}
.drawer::backdrop{background:rgba(7,15,27,.58);backdrop-filter:blur(5px)}
.drawer-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--sp-5);font-size:13px;color:var(--c-text-2)}
.drawer nav{display:grid}.drawer nav a{display:flex;align-items:center;gap:var(--sp-4);padding:var(--sp-4) 0;border-bottom:1px solid var(--c-border);color:var(--c-text);font-size:21px;text-decoration:none}
.drawer nav a[aria-current]{color:var(--c-primary)}.drawer nav a span:first-child{color:var(--c-muted);font-size:11px;font-family:var(--font-mono)}.drawer nav a span:last-child{margin-left:auto;font-size:18px;color:var(--c-muted)}
.drawer p{font-size:12px;color:var(--c-text-2);margin:var(--sp-5) 0 0}
@media (max-width:767px){.nav,.github-link{display:none}.burger{display:inline-grid}.in{gap:var(--sp-3)}.brand-mark{width:35px;height:35px}.brand-name{font-size:19px}.brand-name small{font-size:9px}}
</style>
