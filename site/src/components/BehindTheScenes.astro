---
const {resources} = Astro.props;
const icons = ['📄', '🎞', '</>'];
---
<section class="bts" aria-labelledby="bts-h">
  <h2 id="bts-h">幕后</h2>
  <p class="note">这部片子完全由代码生成。以下文件对应本页版本；原始文件可直接查看或另存。</p>
  <div class="row">{resources.map(({label, file, href, raw}, index) => (
    <div class="file-card">
      <a class="b" href={href} rel="noopener" target="_blank"><span class="i" aria-hidden="true">{icons[index]}</span><span><strong>{label}</strong><small>GitHub · {file} ↗</small></span></a>
      {raw && <a class="raw" href={raw} rel="noopener" target="_blank">原始{label} ↗</a>}
    </div>
  ))}</div>
</section>
<style>
.bts{margin-top:var(--sp-8)}h2{font-size:var(--fs-h2);margin:0 0 var(--sp-2)}
.note{color:var(--c-text-2);font-size:var(--fs-small);margin:0 0 var(--sp-4)}
.row{display:grid;gap:var(--sp-3);grid-template-columns:1fr}
@media (min-width:768px){.row{grid-template-columns:repeat(3,1fr)}}
.file-card{background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md)}
.file-card:has(a:hover){border-color:var(--c-primary-a40)}
.b{display:flex;gap:var(--sp-3);align-items:center;min-height:64px;padding:var(--sp-3) var(--sp-4);color:var(--c-text);text-decoration:none}
.b:hover{color:var(--c-primary);filter:none}
.raw{display:flex;align-items:center;min-height:44px;margin:0 var(--sp-4);border-top:1px solid var(--c-border);font-size:var(--fs-small)}
.i{font-family:var(--font-mono);color:var(--c-primary);width:28px;text-align:center}
.b span:last-child{display:flex;flex-direction:column;line-height:1.4}
small{color:var(--c-text-2);font-family:var(--font-mono);font-size:var(--fs-xs)}
</style>
