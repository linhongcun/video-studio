---
// 按系列浏览（4 个 tab）。渐进增强：无 JS 时每个 tab 跳转 /series/<id>/；有 JS 时就地过滤并同步 ?series=
import {BASE, seriesHref} from '../lib/episodes';
const {series, target = '#all-grid'} = Astro.props;
---
<div class="sf-wrap">
  <div class="sf" role="group" aria-label="按系列浏览" data-target={target}>
    <a class="tab" href={BASE} data-series="" aria-pressed="true">全部 <span class="num">{series.reduce((a, s) => a + s.episodes.length, 0)}</span></a>
    {series.map((s) => <a class="tab" href={seriesHref(s.id)} data-series={s.id} aria-pressed="false" data-desc={s.description}>{s.title} <span class="num">{s.episodes.length}</span></a>)}
  </div>
  <a class="more" href={`${BASE}tags/`}>按标签浏览 →</a>
</div>
<p class="sf-desc" data-sf-desc hidden></p>
<script>
  const box = document.querySelector<HTMLElement>('.sf');
  if (box) {
    const grid = document.querySelector(box.dataset.target!)!;
    const desc = document.querySelector<HTMLElement>('[data-sf-desc]')!;
    const tabs = [...box.querySelectorAll<HTMLAnchorElement>('a[data-series]')];
    const apply = (id: string, push: boolean) => {
      if (id && !tabs.some((t) => t.dataset.series === id)) id = '';
      grid.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const s = li.querySelector<HTMLElement>('[data-series]')?.dataset.series ?? '';
        li.hidden = !!id && s !== id;
      });
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.series === id)));
      const cur = tabs.find((t) => t.dataset.series === id);
      desc.hidden = !id; desc.textContent = id ? cur?.dataset.desc ?? '' : '';
      if (push) { const u = new URL(location.href); id ? u.searchParams.set('series', id) : u.searchParams.delete('series'); history.replaceState(null, '', u); }
    };
    tabs.forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); apply(t.dataset.series!, true); }));
    apply(new URL(location.href).searchParams.get('series') ?? '', false);
  }
</script>
<style>
.sf-wrap{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);flex-wrap:wrap;margin-bottom:var(--sp-3)}
.sf{display:flex;gap:var(--sp-2);flex-wrap:wrap}
.tab{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 16px;border-radius:var(--r-full);border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);text-decoration:none;font-size:var(--fs-small)}
.tab .num{color:var(--c-text-2);font-size:var(--fs-xs)}
.tab:hover{border-color:var(--c-primary);filter:none}
.tab[aria-pressed="true"]{background:var(--c-primary);border-color:var(--c-primary);color:var(--c-on-primary);font-weight:600}
.tab[aria-pressed="true"] .num{color:var(--c-on-primary)}
.more{font-size:var(--fs-small);color:var(--c-text-2)}
.sf-desc{margin:0 0 var(--sp-4);color:var(--c-text-2);font-size:var(--fs-small)}
</style>
