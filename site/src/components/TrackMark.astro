    : id === 'database' ? <><ellipse cx="24" cy="10" rx="16" ry="6" stroke="currentColor" stroke-width="1.5"/><path d="M8 10v27c0 3.3 7.2 6 16 6s16-2.7 16-6V10M8 23c0 3.3 7.2 6 16 6s16-2.7 16-6M8 36c0 3.3 7.2 6 16 6s16-2.7 16-6" stroke="currentColor" stroke-width="1.5"/><ellipse cx="24" cy="10" rx="10" ry="3" fill="currentColor" opacity=".3"/></>
    : id === 'agent' ? <><path d="M16 12h17a8 8 0 0 1 8 8v7m-9 9H15a8 8 0 0 1-8-8v-7" stroke="currentColor" stroke-width="1.5"/><path d="m36 22 5 5 5-5M2 26l5-5 5 5" stroke="currentColor" stroke-width="1.5"/><rect x="10" y="6" width="15" height="12" rx="3" fill="currentColor" opacity=".35"/><rect x="23" y="30" width="15" height="12" rx="3" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="12" r="2" fill="currentColor"/></>
    : id === 'engineering' ? <><circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="1.5"/><path d="M24 9v7m15 8h-7M24 39v-7M9 24h7" stroke="currentColor" stroke-width="1.5"/><circle cx="24" cy="9" r="4" fill="currentColor"/><circle cx="39" cy="24" r="4" fill="currentColor" opacity=".65"/><circle cx="24" cy="39" r="4" fill="currentColor" opacity=".4"/><circle cx="9" cy="24" r="4" fill="currentColor" opacity=".65"/><path d="m20 24 3 3 6-7" stroke="currentColor" stroke-width="1.5"/></>
