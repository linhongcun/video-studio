---
const {id} = Astro.props;
---
<svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  {id === 'systems' ? <><rect x="4" y="8" width="16" height="13" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M12 21v7m0 0h24m-24 0v7m24-7v7M20 14h16v14" stroke="currentColor" stroke-width="1.5"/><rect x="5" y="35" width="14" height="7" rx="2" fill="currentColor" opacity=".3"/><rect x="29" y="35" width="14" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="36" cy="14" r="4" fill="currentColor"/></>
    : id === 'agent' ? <><path d="M16 12h17a8 8 0 0 1 8 8v7m-9 9H15a8 8 0 0 1-8-8v-7" stroke="currentColor" stroke-width="1.5"/><path d="m36 22 5 5 5-5M2 26l5-5 5 5" stroke="currentColor" stroke-width="1.5"/><rect x="10" y="6" width="15" height="12" rx="3" fill="currentColor" opacity=".35"/><rect x="23" y="30" width="15" height="12" rx="3" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="12" r="2" fill="currentColor"/></>
