---
const {id} = Astro.props;
---
<svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  {id === 'redis' ? <><path d="M8 10h32M8 24h32M8 38h32M8 10v28m16-14v14m16-28v28" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="10" r="4" fill="currentColor"/><circle cx="40" cy="10" r="4" fill="currentColor"/><circle cx="8" cy="24" r="4" fill="currentColor" opacity=".65"/><circle cx="24" cy="24" r="4" fill="currentColor" opacity=".65"/><circle cx="40" cy="24" r="4" fill="currentColor" opacity=".65"/><circle cx="8" cy="38" r="4" fill="currentColor" opacity=".35"/><circle cx="24" cy="38" r="4" fill="currentColor" opacity=".35"/><circle cx="40" cy="38" r="4" fill="currentColor" opacity=".35"/></>
    : id === 'systems' ? <><rect x="4" y="8" width="16" height="13" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M12 21v7m0 0h24m-24 0v7m24-7v7M20 14h16v14" stroke="currentColor" stroke-width="1.5"/><rect x="5" y="35" width="14" height="7" rx="2" fill="currentColor" opacity=".3"/><rect x="29" y="35" width="14" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="36" cy="14" r="4" fill="currentColor"/></>
