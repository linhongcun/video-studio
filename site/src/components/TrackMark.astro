    : <><path d="M4 41h40" stroke="currentColor" stroke-width="1.5"/><rect x="7" y="25" width="5" height="12" rx="1" fill="currentColor" opacity=".35"/><rect x="17" y="17" width="5" height="20" rx="1" fill="currentColor" opacity=".5"/><rect x="27" y="7" width="5" height="30" rx="1" fill="currentColor" opacity=".8"/><rect x="37" y="13" width="5" height="24" rx="1" fill="currentColor"/><path d="m8 12 3 3-3 3m32-16-3 3 3 3" stroke="currentColor" stroke-width="1.5"/></>}
</svg>
