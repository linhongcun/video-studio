---
// MDX 映射 h2：带 id 的章节标题旁显示“▶ 从这里看”，点击派发 vs:seek；无 id 的 h2 原样输出
const {id, 'data-chapter': isChapter, 'data-summary': _s, ...rest} = Astro.props;
---
{id && isChapter !== undefined ? (
  <h2 id={id} class="chh" {...rest}>
    <span class="t"><slot /><a class="anchor" href={`#${id}`} aria-label="本节链接">#</a></span>
    <a class="btn btn-ghost from" href="#player" data-seek={id}>▶ 从这里看</a>
  </h2>
) : <h2 id={id} {...rest}><slot /></h2>}
