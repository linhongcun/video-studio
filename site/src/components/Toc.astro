---
const {headings = []} = Astro.props;
const sections = [];
for (const heading of headings) {
  if (heading.depth === 3 && sections.length) sections.at(-1).children.push(heading);
  else sections.push({...heading, children: []});
}
---
{headings.length > 0 && <details class="toc">
  <summary><span>本文目录</span><span class="count">{headings.length} 节 <span class="chevron" aria-hidden="true">⌄</span></span></summary>
  <nav aria-label="图文目录">
    <ol>{sections.map((h) => <li>
      <a href={`#${h.id}`} data-toc={h.id}>{h.title}</a>
      {h.children.length > 0 && <ol class="subsections">{h.children.map((child) => <li><a href={`#${child.id}`} data-toc={child.id}>{child.title}</a></li>)}</ol>}
    </li>)}</ol>
  </nav>
</details>}
<script>
  const directory = document.querySelector<HTMLDetailsElement>('.toc');
  const wide = matchMedia('(min-width: 1200px)');
  if (directory) {
    const setLayout = () => { directory.open = wide.matches; };
    setLayout();
    wide.addEventListener('change', setLayout);
  }
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  if (links.length) {
    const headings = [...new Set(links.map((link) => document.getElementById(link.dataset.toc!)).filter((heading): heading is HTMLElement => !!heading))];
    let frame = 0;
    const updateCurrent = () => {
      frame = 0;
      const padding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      let current: HTMLElement | undefined;
      for (const heading of headings) {
        // Native fragment navigation uses both scroll padding and scroll margin.
        // Track that reading edge, including the optional sticky video height.
        const margin = parseFloat(getComputedStyle(heading).scrollMarginTop) || 0;
        if (heading.getBoundingClientRect().top > padding + margin + 2) break;
        current = heading;
      }
      links.forEach((link) => {
        if (link.dataset.toc === current?.id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(updateCurrent); };
    window.addEventListener('scroll', schedule, {passive: true});
    window.addEventListener('resize', schedule);
    window.addEventListener('hashchange', schedule);
    window.addEventListener('load', schedule, {once: true});
    schedule();
  }
</script>
<style>
.toc{font-size:var(--fs-small);border:1px solid var(--c-border);border-radius:var(--r-md);background:var(--c-surface);padding:var(--sp-4)}
summary{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);list-style:none;cursor:pointer;font-weight:600;color:var(--c-text)}
summary::-webkit-details-marker{display:none}
.count{display:flex;gap:var(--sp-2);align-items:center;color:var(--c-text-2);font-weight:400;font-size:var(--fs-xs)}
.chevron{font-size:18px;line-height:1;transition:transform var(--dur)}
.toc[open] .chevron{transform:rotate(180deg)}
nav{margin-top:var(--sp-3)}
ol{list-style:none;margin:0;padding:0;border-left:1px solid var(--c-border)}
a{display:block;padding:8px 12px;color:var(--c-text-2);text-decoration:none;border-left:2px solid transparent;margin-left:-1px;line-height:1.6}
a:hover{color:var(--c-text)}
a[aria-current]{color:var(--c-primary);border-left-color:var(--c-primary);font-weight:600}
.subsections{border-left:0}
.subsections a{padding-left:24px;font-size:var(--fs-xs)}
@media (min-width:1200px){.toc{position:sticky;top:calc(var(--header-h) + 24px);padding:var(--sp-4);max-height:calc(100vh - var(--header-h) - 48px);overflow:auto}.count{display:none}}
</style>
