---
import {fmtTime} from '../lib/episodes';
const {src, alt, caption, wide = false, seekTo, chapter, width = 1920, height = 1080, n} = Astro.props;
---
<figure class:list={['fig', {wide}]}>
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  {(caption || seekTo !== undefined) && (
    <figcaption>{n && `图 ${n} `}{caption}{seekTo !== undefined && <> · <a href={`?t=${seekTo}#player`} data-seek={chapter}>▶ 在视频中查看 {fmtTime(seekTo)}</a></>}</figcaption>
  )}
</figure>
