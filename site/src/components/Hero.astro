---
import {epHref, asset, fmtTime, epLabel, tagHref, REPO} from '../lib/episodes';
const {e} = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <a class="cover" href={epHref(e.slug)} aria-label={`观看：${e.title}`}>
    <img src={asset(e.slug, e.poster)} alt="" width="1280" height="720" fetchpriority="high" />
    <span class="play" aria-hidden="true">▶</span>
  </a>
  <div class="info">
    <p class="meta num"><span class="ep">{epLabel(e.ep)}</span> · {e.tags[0] && <a href={tagHref(e.tags[0])}>{e.tags[0]}</a>} · {fmtTime(e.duration)}</p>
    <h1 id="hero-title">{e.title}</h1>
    <p class="sum">{e.summary}</p>
    <div class="acts">
      <a class="btn btn-primary" href={epHref(e.slug)}>▶ 看视频 + 图文</a>
      <a class="btn btn-ghost" href={`${REPO}/tree/main/episodes/${e.slug}/remotion`} rel="noopener" target="_blank">源码 ↗</a>
    </div>
  </div>
</section>
<style>
.hero{display:grid;gap:var(--sp-5);padding:var(--sp-7) 0 0;align-items:center;background:radial-gradient(60% 80% at 20% 30%,rgba(34,211,238,.08),transparent 70%)}
@media (min-width:1280px){.hero{grid-template-columns:7fr 5fr;gap:var(--sp-7);padding-top:var(--sp-8)}}
.cover{position:relative;display:block;aspect-ratio:16/9;border-radius:var(--r-lg);overflow:hidden;background:var(--c-surface);border:1px solid var(--c-border)}
.cover img{display:block;width:100%;height:100%;object-fit:cover}
.play{position:absolute;right:16px;bottom:16px;width:64px;height:64px;border-radius:50%;border:2px solid var(--c-primary);background:rgba(11,16,32,.6);color:var(--c-primary);display:grid;place-items:center;font-size:22px;padding-left:4px;transition:transform var(--dur) var(--ease)}
.cover:hover .play{transform:scale(1.08)}
@media (max-width:767px){.play{width:48px;height:48px;right:12px;bottom:12px;font-size:17px}}
.meta{margin:0;color:var(--c-text-2);font-size:var(--fs-small)}
.ep{font-family:var(--font-mono);color:var(--c-primary)}
h1{font-size:var(--fs-display);line-height:1.2;font-weight:700;margin:var(--sp-2) 0 var(--sp-3)}
.sum{color:var(--c-text-2);margin:0 0 var(--sp-5)}
.acts{display:flex;gap:var(--sp-3);flex-wrap:wrap}
</style>
