---
// 渐进增强：无 JS 时每个 pill 是跳转 /tags/<tag>/ 的链接；有 JS 时就地过滤并同步 ?tag=
import TagPill from './TagPill.astro';
import {BASE, tagHref} from '../lib/episodes';
const {tags, target = '#all-grid'} = Astro.props;
---
<div class="tf" role="group" aria-label="按标签筛选" data-target={target}>
  <TagPill tag="" href={BASE} label="全部" active />
  {tags.map((t) => <TagPill tag={t.name} href={tagHref(t.name)} label={t.name} />)}
</div>
<script>
  const box = document.querySelector<HTMLElement>('.tf');
  if (box) {
    const grid = document.querySelector(box.dataset.target!)!;
    const empty = document.querySelector<HTMLElement>('#tf-empty');
    const pills = [...box.querySelectorAll<HTMLAnchorElement>('a[data-tag]')];
    const apply = (tag: string, push: boolean) => {
      let shown = 0;
      grid.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const tags = (li.querySelector<HTMLElement>('[data-tags]')?.dataset.tags ?? '').split('|');
        const ok = !tag || tags.includes(tag);
        li.hidden = !ok; if (ok) shown++;
      });
      pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.tag === tag)));
      if (empty) empty.hidden = shown > 0;
      if (push) { const u = new URL(location.href); tag ? u.searchParams.set('tag', tag) : u.searchParams.delete('tag'); history.replaceState(null, '', u); }
    };
    pills.forEach((p) => p.addEventListener('click', (e) => { e.preventDefault(); apply(p.dataset.tag!, true); }));
    apply(new URL(location.href).searchParams.get('tag') ?? '', false);
  }
</script>
<style>
.tf{display:flex;gap:var(--sp-2);overflow-x:auto;padding:var(--sp-1) 2px var(--sp-3);margin-bottom:var(--sp-4);scrollbar-width:thin}
</style>
