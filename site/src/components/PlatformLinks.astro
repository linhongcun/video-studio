---
// 去平台看（点赞 / 评论 / 关注）。只显示 meta.json platforms 里填了真实链接的平台；一个都没有时整块不渲染。
// 一个链接都没有时，只给一行文字提示去平台搜账号名（不拼链接）。
import {ACCOUNT} from '../lib/episodes';
const {platforms = []} = Astro.props;
---
{platforms.length === 0 && <p class="pl hint">B站 · 抖音 · 快手 搜索「{ACCOUNT}」，点赞 · 评论 · 关注</p>}
{platforms.length > 0 && (
  <nav class="pl" aria-label="在其他平台观看">
    <span class="lbl">去平台点赞 · 评论 · 关注：</span>
    {platforms.map((p) => <a class={`b b-${p.id}`} href={p.url} rel="noopener" target="_blank">{p.label} ↗</a>)}
  </nav>
)}
<style>
.pl{display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-2);margin:0 0 var(--sp-5);font-size:var(--fs-small);color:var(--c-text-2)}
.hint{margin-top:calc(-1 * var(--sp-3))}
.b{display:inline-flex;align-items:center;min-height:36px;padding:0 14px;border-radius:var(--r-full);border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);text-decoration:none}
.b:hover{border-color:var(--c-primary);filter:none}
</style>
