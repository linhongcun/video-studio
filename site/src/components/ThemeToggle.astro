---
const opts = [['system', '跟随系统'], ['light', '浅色'], ['dark', '深色']];
---
<div class="theme-picker">
  <button class="theme-trigger icon-button" type="button" aria-label="选择外观：跟随系统" aria-expanded="false" aria-controls="theme-options" title="切换外观"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="7.5"/><path d="M12 4.5a7.5 7.5 0 0 1 0 15Z" fill="currentColor" stroke="none"/></svg></button>
  <div id="theme-options" class="theme-options" role="radiogroup" aria-label="页面外观" hidden>
    {opts.map(([value, label]) => <button type="button" role="radio" data-theme-opt={value} aria-checked="false" tabindex="-1"><span>{label}</span><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 10 3 3 7-7"/></svg></button>)}
  </div>
</div>
<script>
  const picker = document.querySelector<HTMLElement>('.theme-picker')!;
  const trigger = picker.querySelector<HTMLButtonElement>('.theme-trigger')!;
  const options = picker.querySelector<HTMLElement>('.theme-options')!;
  const buttons = [...options.querySelectorAll<HTMLButtonElement>('[data-theme-opt]')];
  const theme = (window as any).__vsTheme;
  const sync = () => {
    const preference = theme?.get() ?? 'system';
    buttons.forEach((button) => { const selected = button.dataset.themeOpt === preference; button.setAttribute('aria-checked', String(selected)); button.tabIndex = selected ? 0 : -1; });
    trigger.setAttribute('aria-label', `选择外观：${buttons.find((button) => button.dataset.themeOpt === preference)?.textContent?.trim() ?? '跟随系统'}`);
  };
  const close = (restoreFocus = false) => { options.hidden = true; trigger.setAttribute('aria-expanded', 'false'); if (restoreFocus) trigger.focus(); };
  trigger.addEventListener('click', () => {
    if (!options.hidden) return close();
    options.hidden = false; trigger.setAttribute('aria-expanded', 'true');
    buttons.find((button) => button.getAttribute('aria-checked') === 'true')?.focus();
  });
  buttons.forEach((button, index) => {
    button.addEventListener('click', () => { theme?.set(button.dataset.themeOpt); sync(); close(true); });
    button.addEventListener('keydown', (event) => {
      const direction = ['ArrowRight', 'ArrowDown'].includes(event.key) ? 1 : ['ArrowLeft', 'ArrowUp'].includes(event.key) ? -1 : 0;
      const next = direction ? (index + direction + buttons.length) % buttons.length : event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : -1;
      if (next < 0) return;
      event.preventDefault(); theme?.set(buttons[next].dataset.themeOpt); sync(); buttons[next].focus();
    });
  });
  picker.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !options.hidden) { event.preventDefault(); close(true); } });
  picker.addEventListener('focusout', (event) => { if (!picker.contains(event.relatedTarget as Node)) close(); });
  document.addEventListener('click', (event) => { if (!picker.contains(event.target as Node)) close(); });
  sync();
</script>
<style>
.theme-picker{position:relative;display:flex}
.theme-trigger[aria-expanded="true"]{background:var(--c-surface-2);color:var(--c-primary)}
.theme-options{position:absolute;right:0;top:calc(100% + 12px);width:164px;padding:6px;background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);box-shadow:var(--shadow-2);z-index:80}
.theme-options button{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);width:100%;min-height:44px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:var(--c-text-2);font:inherit;font-size:14px;text-align:left;cursor:pointer}
.theme-options button:hover{background:var(--c-surface-2);color:var(--c-text)}.theme-options button[aria-checked="true"]{background:var(--c-primary-a12);color:var(--c-primary)}
.theme-options svg{width:18px;height:18px;stroke:currentColor;stroke-width:1.8;visibility:hidden}.theme-options button[aria-checked="true"] svg{visibility:visible}
</style>
