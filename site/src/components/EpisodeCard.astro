---
import {epHref, asset, fmtTime, epLabel, fmtDateShort, isNew} from '../lib/episodes';
const {e} = Astro.props;
---
<a class="card" href={epHref(e.slug)} data-tags={e.tags.join('|')} data-series={e.series ?? ''}>
  <div class="cover">
    <img src={asset(e.slug, e.poster)} alt="" width="1280" height="720" loading="lazy" decoding="async" />
    <span class="dur num" aria-label={`时长 ${fmtTime(e.duration)}`}>{fmtTime(e.duration)}</span>
  </div>
  <div class="body">
    <p class="row"><span class="ep num">{epLabel(e.ep)}</span><time class="date num" datetime={e.date}>{fmtDateShort(e.date)}</time>{isNew(e.date, e.slug) && <span class="new">NEW</span>}</p>
    <h3>{e.title}</h3>
    <p>{e.summary}</p>
    <div class="tags">{e.tags.slice(0, 3).map((t) => <span class="t">#{t}</span>)}</div>
  </div>
</a>
<style>
.card{display:flex;flex-direction:column;background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-lg);overflow:hidden;color:inherit;text-decoration:none;transition:transform var(--dur) var(--ease),box-shadow var(--dur) var(--ease),border-color var(--dur)}
.card:hover{transform:translateY(-2px);box-shadow:var(--shadow-2);border-color:var(--c-primary-a40);filter:none}
.card:focus-visible{box-shadow:var(--focus-ring)}
.cover{position:relative;aspect-ratio:16/9;overflow:hidden;background:var(--c-surface-2)}
.cover img{display:block;width:100%;height:100%;object-fit:cover;transition:transform var(--dur) var(--ease)}
.card:hover .cover img{transform:scale(1.03)}
.dur{position:absolute;right:8px;bottom:8px;background:var(--c-overlay);color:var(--c-on-overlay);font-size:var(--fs-xs);padding:2px 6px;border-radius:var(--r-sm)}
.body{padding:var(--sp-4) var(--sp-4) var(--sp-5);display:flex;flex-direction:column;gap:var(--sp-2)}
.row{margin:0;display:flex;align-items:center;gap:var(--sp-2);font-size:var(--fs-xs)}
.date{color:var(--c-text-2)}
.new{font-size:10px;font-weight:700;letter-spacing:.04em;line-height:1;padding:3px 6px;border-radius:var(--r-full);background:var(--c-primary);color:var(--c-on-primary)}
.ep{font-family:var(--font-mono);color:var(--c-primary);font-size:var(--fs-xs)}
h3{margin:0;font-size:var(--fs-h3);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
p{margin:0;color:var(--c-text-2);font-size:var(--fs-small);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tags{display:flex;gap:var(--sp-2);flex-wrap:wrap}
.t{font-size:var(--fs-xs);color:var(--c-tag);border:1px solid var(--c-border);border-radius:var(--r-full);padding:1px 8px}
</style>
