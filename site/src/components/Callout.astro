---
const {type = 'info', title} = Astro.props;
const icon = {info: 'ℹ', tip: '✓', warn: '!', danger: '✕'}[type];
---
<aside class:list={['callout', `callout-${type}`]} role="note">
  <span class="ci" aria-hidden="true">{icon}</span>
  <div class="cbody">{title && <p class="ctitle">{title}</p>}<slot /></div>
</aside>
