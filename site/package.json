{
  "name": "video-studio-site",
  "version": "0.71.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:dates": "node scripts/check-episode-dates.mjs",
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "npm run copy-assets && astro dev",
    "build": "npm run check:dates && npm run check:references && npm run copy-assets && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check:references": "node scripts/check-references.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
