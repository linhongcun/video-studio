# Ignore dependency directories and local reuse symlinks.
node_modules
out/
*.mp4
.DS_Store
!episodes/*/*/publication/video.mp4
site/public/episodes/
site/public/videos/
site/dist/
site/.astro/
preview/
__pycache__/
.env
*.env
.mimo.env

# Rebuildable Remotion browser/download cache
/.remotion/

# Rebuildable new-episode audio copies and intermediate QA caches (L2)
episodes/*/*/production/**/remotion/public/audio/voice.wav
episodes/*/*/production/**/voice/sentences/*.wav
episodes/*/*/production/**/qa-self/
episodes/*/*/production/**/qa-own/
episodes/*/*/production/**/qa-prevoice/
*.raw
*.yuv
