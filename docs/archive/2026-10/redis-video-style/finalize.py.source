from pathlib import Path
from datetime import datetime, timezone, timedelta
import hashlib, json, shutil, subprocess, gzip

ROOT = Path.cwd().resolve()
W = ROOT / 'work/redis-video-style'
A = ROOT / 'docs/archive/2026-10/redis-video-style'
REV = ROOT / 'episodes-codex/redis-skiplist/revisions/redis-style'
PUB = ROOT / 'episodes/redis-skiplist'

def read(p): return json.loads(p.read_text())
def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
def write(p, d):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(d, ensure_ascii=False, indent=2) + '\n')
def frame(video, n, dest):
    second, offset = divmod(n, 30)
    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-ss', str(second), '-i', str(video),
                    '-vf', f'select=eq(n\\,{offset})', '-frames:v', '1', '-fps_mode', 'vfr',
                    *(['-q:v', '2'] if dest.suffix == '.jpg' else []), str(dest)], check=True)

result = read(REV / 'render-result.json')
old = read(REV / 'baseline-publication.json')
receipt = read(REV / 'reference-appendix.json')
check = read(REV / 'reference-appendix-media-check.json')
video = REV / 'video.mp4'
assert result['visualRevision'] == 'redis-style-v1'
assert sha(video) == result['sha256'] == receipt['outputSHA256'] == check['outputSHA256']
assert check['passed'] and all(check[k] for k in ['bodyDecodedFramesAndTimestampsEqual', 'outputVideoTimelineContinuous', 'audioPacketsAndTimingEqual'])
assert result['frames'] == 4707 and result['bodyFrames'] == 4557
assert result['baselineAudioPreserved']['passed']
assert result['newProductionManifestSHA256'] == sha(REV / 'source-sha256.json')
assert read(PUB / 'meta.json') == old['publishedMetadata']
assert (PUB / 'article.mdx').read_bytes() == (REV / 'article.mdx').read_bytes()

dest = A / 'final'
dest.mkdir(parents=True, exist_ok=True)
frames = [0, 196, 944, 1000, 1373, 1740, 1850, 2060, 2130, 2556,
          2667, 2784, 2785, 2810, 2832, 2900, 3104, 3124, 3195, 3215,
          3570, 3597, 3689, 3715, 4278, 4556, 4557, 4632, 4706]
samples = []
for n in frames:
    p = dest / f'frame-{n:06d}.png'
    frame(video, n, p)
    samples.append({'frame': n, 'file': str(p.relative_to(ROOT)), 'sha256': sha(p)})

figure = PUB / 'article/height-one.jpg'
before_figure = hashlib.sha256(subprocess.check_output(['git', 'show', old['baselineCommit'] + ':' + str(figure.relative_to(ROOT))])).hexdigest()
figure.parent.mkdir(parents=True, exist_ok=True)
frame(video, 2667, figure)
before_meta = sha(PUB / 'meta.json')
meta = read(PUB / 'meta.json')
meta.update(result['publicationMetadata'])
meta['updatedAt'] = datetime.fromisoformat(result['createdAtUTC']).astimezone(timezone(timedelta(hours=8))).isoformat(timespec='seconds')
meta['burnedInCaptions'] = True
changed = {k for k in set(meta) | set(old['publishedMetadata']) if meta.get(k) != old['publishedMetadata'].get(k)}
assert changed <= {'updatedAt', 'burnedInCaptions'} | set(result['publicationMetadata'])
write(PUB / 'meta.json', meta)
for name in ['video.mp4', 'reference-appendix.json', 'reference-appendix-media-check.json', 'render-result.json']:
    shutil.copyfile(REV / name, PUB / name)
    assert sha(PUB / name) == sha(REV / name)

for name in ['preflight', 'preflight-critical', 'visual-initial', 'visual-focus']:
    source = W / name
    if source.is_dir():
        target = A / name
        target.mkdir(exist_ok=True)
        for p in source.iterdir():
            if p.suffix == '.png': shutil.copyfile(p, target / p.name)
            elif p.suffix == '.json': (target / (p.name + '.gz')).write_bytes(gzip.compress(p.read_bytes(), mtime=0))
for name in ['preflight', 'preflight-critical', 'render', 'npm-ci']:
    p = W / (name + '.log')
    if p.exists(): (A / (name + '.log.gz')).write_bytes(gzip.compress(p.read_bytes(), mtime=0))

report = {'status': 'installed-media-verified', 'sha256': sha(video), 'bytes': video.stat().st_size,
          'frames': 4707, 'bodyFrames': 4557, 'referenceFrames': 150, 'samples': samples,
          'completeBaselineAudio': result['baselineAudioPreserved'],
          'bodyFramesAndTimestampsPreservedByAppendixEngine': True,
          'metadata': {'beforeSHA256': before_meta, 'afterSHA256': sha(PUB / 'meta.json'), 'changedFields': sorted(changed), 'sourcePathPreserved': True},
          'article': {'mdxBytesPreserved': True, 'sha256': sha(PUB / 'article.mdx'), 'figureSeconds': 88.9, 'figureFrame': 2667, 'figureBeforeSHA256': before_figure, 'figureSHA256': sha(figure)},
          'stillsMethod': 'Previously verified exact CFR integer-second input seek plus relative frame select; no extra full decode solely to make stills.',
          'oldProductionOutputsPreserved': True}
write(A / 'final-media-summary.json', report)
print(json.dumps({'status': report['status'], 'sha256': report['sha256'], 'frames': 4707, 'samples': len(samples)}))
