 "tcc-try-1": {
  "audioSec": 7.167,
  "audioFrames": 215,
  "duration": 233,
  "chapterOffsetFrames": 0,
  "chapter": "tcc-try",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "蓝站先在货上贴一张已预留的封条，货还在架上，但别人买不走，这一步叫预留。",
    "start": 0.0,
    "dur": 7.161,
    "src": "ch10-1"
   }
  ]
 },
 "tcc-confirm-1": {
  "audioSec": 9.633,
  "audioFrames": 289,
  "duration": 298,
  "chapterOffsetFrames": 0,
  "chapter": "tcc-confirm",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "之后由调度员喊：订单成了，就确认，撕掉封条，真正出库；订单没成，就取消，撕掉封条，货留在架上照常卖。",
    "start": 0.0,
    "dur": 9.644,
    "src": "ch11-1"
   }
  ]
 },
 "tcc-confirm-2": {
  "audioSec": 2.867,
  "audioFrames": 86,
  "duration": 104,
  "chapterOffsetFrames": 298,
  "chapter": "tcc-confirm",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "最后要么都确认，要么都取消。",
    "start": 0.0,
    "dur": 2.86,
    "src": "ch11-2"
   }
  ]
 },
 "tcc-cost-1": {
  "audioSec": 10.633,
  "audioFrames": 319,
  "duration": 336,
  "chapterOffsetFrames": 0,
  "chapter": "tcc-cost",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "这样锁货的时间短；代价是：每个业务都得自己写预留、确认、取消这三套动作，还得防着同一个指令重复送来。",
    "start": 0.0,
    "dur": 10.62,
    "src": "ch12-1"
   }
  ]
 },
 "tcc-wrap-1": {
  "audioSec": 4.433,
  "audioFrames": 133,
  "duration": 151,
  "chapterOffsetFrames": 0,
  "chapter": "tcc-wrap",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "这就是 TCC：先预留，再确认或取消。",
    "start": 0.0,
    "dur": 4.443,
    "src": "ch13-1"
   }
  ]
 },
