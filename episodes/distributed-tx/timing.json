  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "第二种，TCC。",
    "start": 0.0,
    "dur": 1.498,
    "src": "ch9-1"
   },
   {
    "text": "它不靠数据库锁货，改成业务自己贴封条。",
