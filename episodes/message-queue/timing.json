  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "放在一起看：缓存帮网站省一趟路，消息队列帮网站扛住高峰。",
    "start": 0.0,
    "dur": 5.817
   },
   {
    "text": "再加上前几期的门店和柜台，网站才能又快又稳，订单也一个不丢。",
    "start": 6.097,
    "dur": 6.146
   }
  ],
  "source": "/workspace/share/ep9-timing.json:recap-1"
 },
