   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "人一多，前台越堵越长，后厨被挤得手忙脚乱，有的单子干脆就弄丢了。",
     "start": -0.003,
     "dur": 6.167
    },
    {
