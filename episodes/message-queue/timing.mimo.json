   "sentences": [
    {
     "text": "上一期我们在后厨放了一张备菜台，让出菜更快。",
     "start": 0.0,
     "dur": 4.22
    },
    {
     "text": "可到了双十一零点，成千上万的人同时下单，后厨再快也做不过来。",
     "start": 4.5,
     "dur": 5.434
    }
   ]
  },
  "hook-2": {
   "start": 306,
