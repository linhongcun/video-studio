   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "先看不排队会怎样。",
     "start": 0.0,
     "dur": 1.786
    },
    {
     "text": "前台每收一单，就站在那里等后厨做完，才去接下一位。",
     "start": 2.066,
     "dur": 4.332
    },
    {
     "text": "这种一单等一单的做法，技术上叫同步。",
     "start": 6.678,
     "dur": 4.306
    }
   ]
  },
  "sync-2": {
   "start": 981,
