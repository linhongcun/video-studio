          ],
          "causalFocus": "简单本地业务保护",
          "resetFrom": null,
          "durationInFrames": 539,
          "voice": [
            {
              "localStart": 12,
              "localEnd": 285
            },
            {
              "localStart": 297,
              "localEnd": 504
            }
          ],
          "subtitles": [
            {
              "text": "乙发现这个业务键已经处理过，就跳过加分，积分仍是十分，再把Kafka进度提交成一。",
              "from": 12,
              "to": 284
            },
            {
              "text": "日志一条、业务尝试两次、效果一次，这就是消费幂等要守住的关系。",
              "from": 297,
              "to": 503
            }
          ]
        }
