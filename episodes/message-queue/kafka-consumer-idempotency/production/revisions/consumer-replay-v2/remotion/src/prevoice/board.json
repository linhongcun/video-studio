            "a-halted"
          ],
          "causalFocus": "Kafka恢复主因果",
          "resetFrom": null,
          "durationInFrames": 532,
          "voice": [
            {
              "localStart": 12,
              "localEnd": 212
            },
            {
              "localStart": 224,
              "localEnd": 497
            }
          ],
          "subtitles": [
            {
              "text": "就在数据库提交之后、Kafka进度提交之前，假设甲进程退出。",
              "from": 12,
              "to": 211
            },
            {
              "text": "甲内存中的一消失了，留下的是日志里的原记录、数据库的十分，以及Kafka保存的零。",
              "from": 224,
              "to": 496
            }
          ]
        },
        {
          "id": "07",
          "slug": "restore-offset",
          "visualType": "restore-offset",
          "chapterId": "replay",
          "chapterTitle": "同一记录怎样重来",
          "cues": [],
          "modelState": "b-offset-requested",
          "modelStages": [
            "b-offset-requested",
            "b-committed-loaded",
            "b-position-installed"
          ],
          "causalFocus": "Kafka恢复主因果",
          "resetFrom": null,
          "durationInFrames": 479,
          "voice": [
            {
              "localStart": 12,
              "localEnd": 245
            },
            {
              "localStart": 257,
              "localEnd": 444
            }
          ],
          "subtitles": [
            {
              "text": "接手的消费者乙没有甲的内存位置，它先向Kafka查询这个组保存的进度。",
              "from": 12,
              "to": 244
            },
            {
              "text": "拿到零后，客户端把零装进乙自己的读取位置，作为恢复起点。",
              "from": 257,
              "to": 443
            }
          ]
        },
        {
          "id": "08",
          "slug": "fetch-same-record",
          "visualType": "fetch-same-record",
          "chapterId": "replay",
          "chapterTitle": "同一记录怎样重来",
          "cues": [],
          "modelState": "b-position-installed",
          "modelStages": [
            "b-position-installed",
            "b-fetch-sent",
            "b-polled-same"
          ],
          "causalFocus": "Kafka恢复主因果",
          "resetFrom": null,
          "durationInFrames": 519,
          "voice": [
            {
              "localStart": 12,
              "localEnd": 219
            },
            {
              "localStart": 231,
              "localEnd": 484
            }
          ],
          "subtitles": [
            {
              "text": "接下来生成读取请求时，客户端把这个零填进请求，要求从零开始取。",
              "from": 12,
              "to": 218
            },
            {
              "text": "返回的仍是原来的事件和零号位置，并没有生产者第二次发送，也没有新写一条消息。",
              "from": 231,
              "to": 483
            }
          ]
        },
        {
          "id": "09",
          "slug": "repeated-effect",
          "visualType": "repeated-effect",
          "chapterId": "replay",
          "chapterTitle": "同一记录怎样重来",
          "cues": [],
          "modelState": "b-polled-same",
          "modelStages": [
            "b-polled-same",
            "unguarded-db-pending",
            "unguarded-twenty"
          ],
          "causalFocus": "Kafka恢复主因果",
          "resetFrom": null,
          "durationInFrames": 492,
          "voice": [
            {
              "localStart": 12,
              "localEnd": 225
            },
            {
              "localStart": 237,
              "localEnd": 457
            }
          ],
          "subtitles": [
            {
              "text": "如果积分业务见到事件就加十分，这次又会执行一次，积分变成二十分。",
              "from": 12,
              "to": 224
            },
            {
              "text": "重复的是对同一条记录的业务处理，不是Kafka日志里多了一条记录。",
              "from": 237,
              "to": 456
            }
          ]
        },
        {
          "id": "10",
          "slug": "commit-too-early",
          "visualType": "commit-too-early",
          "chapterId": "guard",
          "chapterTitle": "怎样避免重复效果",
          "cues": [],
          "modelState": "early-reset",
          "modelStages": [
            "early-reset",
            "early-commit-requested",
            "early-committed",
            "early-a-halted",
            "early-b-offset-requested",
            "early-b-committed-loaded",
            "early-b-position-installed",
            "early-b-fetch-sent",
            "early-b-poll-empty"
          ],
          "causalFocus": "提交顺序反例",
          "resetFrom": "a-polled",
          "durationInFrames": 612,
          "voice": [
            {
              "localStart": 12,
              "localEnd": 312
            },
            {
              "localStart": 324,
              "localEnd": 577
            }
          ],
          "subtitles": [
            {
              "text": "能不能先提交Kafka进度，再去加分：回到尚未加分时，先把恢复位置提交成一，接着进程退出。",
              "from": 12,
              "to": 311
            },
            {
              "text": "乙就会从一开始，越过还没加分的零号记录；提前提交把重复风险换成了漏处理风险。",
              "from": 324,
              "to": 576
            }
          ]
        },
        {
          "id": "11",
          "slug": "bind-business-key",
          "visualType": "bind-business-key",
          "chapterId": "guard",
          "chapterTitle": "怎样避免重复效果",
          "cues": [],
          "modelState": "guard-reset",
          "modelStages": [
            "guard-reset",
            "guard-first-db-pending",
            "guard-db-committed",
            "guard-a-halted",
            "guard-b-offset-requested",
            "guard-b-committed-loaded",
            "guard-b-position-installed",
            "guard-b-fetch-sent",
            "guard-b-polled-same"
          ],
          "causalFocus": "简单本地业务保护",
          "resetFrom": "a-polled",
          "durationInFrames": 599,
          "voice": [
            {
              "localStart": 12,
              "localEnd": 225
            },
            {
              "localStart": 237,
              "localEnd": 564
            }
          ],
          "subtitles": [
            {
              "text": "再回到第一次加分之前，应用给积分业务和这条事件一个稳定的业务键。",
              "from": 12,
              "to": 224
            },
            {
              "text": "在同一个数据库事务里，登记这个键和加十分一起提交；然后即使在Kafka提交前退出，乙仍会按零重读。",
              "from": 237,
              "to": 563
            }
          ]
        },
        {
          "id": "12",
          "slug": "idempotent-effect",
          "visualType": "idempotent-effect",
          "chapterId": "guard",
          "chapterTitle": "怎样避免重复效果",
          "cues": [],
          "modelState": "guard-b-polled-same",
          "modelStages": [
            "guard-b-polled-same",
            "guard-duplicate-skipped",
