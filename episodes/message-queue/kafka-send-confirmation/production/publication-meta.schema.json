{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MQ04 site publication metadata",
  "type": "object",
  "required": [
    "slug",
    "ep",
    "title",
    "summary",
    "series",
    "episodePart",
    "createdAt",
    "updatedAt",
    "publishedAt",
    "firstRelease",
    "video",
    "poster",
    "draft",
    "sourcePath",
    "finalVideoFrames",
    "referenceAppendix",
    "burnedInCaptions",
    "platforms"
  ],
  "properties": {
    "slug": {
      "const": "kafka-send-confirmation"
    },
    "ep": {
      "const": 44
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "const": "message-queue"
    },
    "episodePart": {
      "type": "string",
      "pattern": "^Kafka MQ04"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "firstRelease": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "video": {
      "const": "video.mp4"
    },
    "poster": {
      "const": "cover-16x9.jpg"
    },
    "draft": {
      "const": false
    },
    "sourcePath": {
      "const": "episodes-codex/kafka-send-confirmation/remotion"
    },
    "finalVideoFrames": {
      "type": "integer",
      "minimum": 1
    },
    "burnedInCaptions": {
      "type": "boolean"
    },
    "platforms": {
      "type": "object",
      "maxProperties": 0
    },
    "referenceAppendix": {
      "type": "object",
      "required": [
        "kind",
        "from",
        "durationInFrames",
        "sources",
        "manifest"
      ],
      "properties": {
        "kind": {
          "const": "references"
        },
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "durationInFrames": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "const": "references.json"
        },
        "manifest": {
          "const": "reference-appendix.json"
        }
      }
    }
  },
  "description": "Describes the final local site-input record. Real dates and frames come from this production and render-result.json; this schema is not a publication or QA receipt."
}
