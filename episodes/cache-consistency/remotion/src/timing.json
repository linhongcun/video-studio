    "start": 0.0,
    "dur": 5.38,
    "src": "ch6-11"
   }
  ]
 },
 "card-4": {
  "card": true,
  "name": "第四层 · 主从延迟",
  "background": "#1E293B",
  "duration": 78,
  "origDuration": 0,
  "labelHold": 78,
  "holdAt": 0,
  "extraHold": 78,
  "insertBeforeSentence": "ch7-1",
  "insertBeforeText": "第四层，很多网站还有从库：好比区域分部有一份价目表副本，只照着总部抄，自己从不改价，是只读副本。",
  "sentences": [],
  "provisional": false,
  "note": "章节卡静音 78 帧（2.60 s），插在 ch7-1 句首之前（上一章章间停顿之后）"
 },
 "replica-1": {
  "audioSec": 10.3,
  "audioFrames": 309,
  "duration": 318,
  "chapterOffsetFrames": 0,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "第四层，很多网站还有从库：好比区域分部有一份价目表副本，只照着总部抄，自己从不改价，是只读副本。",
    "start": 0.0,
    "dur": 10.31,
    "src": "ch7-1"
   }
  ]
 },
 "replica-2": {
  "audioSec": 8.3,
  "audioFrames": 249,
  "duration": 257,
  "chapterOffsetFrames": 318,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "主从延迟，就是分部总比总部慢半拍，店员图近去分部抄价，那边还没收到新价。",
    "start": 0.0,
    "dur": 8.31,
    "src": "ch7-2"
   }
  ]
 },
 "replica-3": {
  "audioSec": 6.6,
  "audioFrames": 198,
  "duration": 206,
  "chapterOffsetFrames": 575,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "于是就算先改库再删缓存，顺序全对，旧价还是被抄回了价签。",
    "start": 0.013,
    "dur": 6.58,
    "src": "ch7-3"
   }
  ]
 },
 "replica-4": {
  "audioSec": 9.667,
  "audioFrames": 290,
  "duration": 298,
  "chapterOffsetFrames": 781,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "一种办法是回填缓存时直接读主库；另一种是订阅从库的变更日志再删，可以减小主从延迟带来的空隙。",
    "start": 0.007,
    "dur": 9.65,
    "src": "ch7-4"
   }
  ]
 },
 "replica-5": {
  "audioSec": 8.467,
  "audioFrames": 254,
  "duration": 262,
  "chapterOffsetFrames": 1079,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "但收到事件不代表改动已经能读到，仍需重试，也仍可能有旧值回填，最后靠过期时间兜底。",
    "start": 0.003,
    "dur": 8.45,
    "src": "ch7-5"
   }
  ]
 },
 "replica-6": {
  "audioSec": 7.333,
  "audioFrames": 220,
  "duration": 229,
  "chapterOffsetFrames": 1341,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "代价是读主库会加重主库的压力；订阅从库要多等一会儿，旧价也会多留一会儿。",
    "start": 0.0,
    "dur": 7.34,
    "src": "ch7-6"
   }
  ]
 },
 "replica-7": {
  "audioSec": 6.5,
  "audioFrames": 195,
  "duration": 203,
  "chapterOffsetFrames": 1570,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "读主库回填，适合刚改完就要马上看到的数据，比如价格、库存。",
    "start": 0.0,
    "dur": 6.49,
    "src": "ch7-7"
   }
  ]
 },
 "replica-8": {
  "audioSec": 4.667,
  "audioFrames": 140,
  "duration": 159,
  "chapterOffsetFrames": 1773,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "这就是主从延迟：副本慢半拍，回填要防着它。",
    "start": 0.0,
    "dur": 4.68,
    "src": "ch7-8"
   }
  ]
 },
 "card-5": {
  "card": true,
  "name": "兜底 · 过期时间",
  "background": "#1E293B",
  "duration": 78,
  "origDuration": 0,
  "labelHold": 78,
  "holdAt": 0,
  "extraHold": 78,
  "insertBeforeSentence": "ch8-1",
  "insertBeforeText": "最后还有一道兜底：每张价签都写上有效期，到点自动撕掉。",
  "sentences": [],
  "provisional": false,
  "note": "章节卡静音 78 帧（2.60 s），插在 ch8-1 句首之前（上一章章间停顿之后）"
 },
 "ttl-1": {
  "audioSec": 6.033,
  "audioFrames": 181,
  "duration": 189,
  "chapterOffsetFrames": 0,
  "chapter": "ttl",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "最后还有一道兜底：每张价签都写上有效期，到点自动撕掉。",
    "start": 0.0,
    "dur": 6.02,
    "src": "ch8-1"
   }
  ]
 },
 "ttl-2": {
  "audioSec": 8.1,
  "audioFrames": 243,
  "duration": 251,
  "chapterOffsetFrames": 189,
  "chapter": "ttl",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "过期时间，也就是 TTL，保证一张旧价签不会永远贴着；它只看时间，不看价格变没变。",
    "start": 0.0,
    "dur": 8.09,
    "src": "ch8-2"
   }
  ]
 },
 "ttl-3": {
  "audioSec": 6.133,
  "audioFrames": 184,
  "duration": 192,
  "chapterOffsetFrames": 440,
  "chapter": "ttl",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "代价是设得太短，查价老要跑总部；设得太长，旧价留得久。",
    "start": 0.003,
    "dur": 6.13,
    "src": "ch8-3"
   }
  ]
 },
 "ttl-4": {
  "audioSec": 4.167,
  "audioFrames": 125,
  "duration": 134,
  "chapterOffsetFrames": 632,
  "chapter": "ttl",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "有效期设多长，就看这门生意能容忍价签旧多久。",
    "start": 0.013,
    "dur": 4.17,
    "src": "ch8-4"
   }
  ]
 },
 "ttl-5": {
  "audioSec": 5.9,
  "audioFrames": 177,
  "duration": 185,
  "chapterOffsetFrames": 766,
  "chapter": "ttl",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "写回缓存时也要记得带上过期时间，不然这张价签就永远不会过期。",
    "start": 0.0,
    "dur": 5.9,
    "src": "ch8-5"
   }
  ]
 },
 "ttl-6": {
  "audioSec": 3.267,
  "audioFrames": 98,
  "duration": 115,
  "chapterOffsetFrames": 951,
  "chapter": "ttl",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "这就是过期时间：最后一道安全网。",
    "start": 0.01,
    "dur": 3.25,
    "src": "ch8-6"
   }
  ]
 },
 "eventual-1": {
  "audioSec": 8.233,
  "audioFrames": 247,
  "duration": 255,
  "chapterOffsetFrames": 0,
  "chapter": "eventual",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "想让价签和价目表每一刻都一样，就得在改价时挡住所有查价，或者加锁排队，读写都会变慢。",
    "start": 0.0,
    "dur": 8.23,
    "src": "ch9-1"
   }
  ]
 },
 "eventual-2": {
  "audioSec": 7.767,
  "audioFrames": 233,
  "duration": 241,
  "chapterOffsetFrames": 255,
  "chapter": "eventual",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "最终一致，就是允许价签旧一会儿，但保证最后一定变新，常见的网站都这么做，这很正常。",
    "start": 0.01,
    "dur": 7.76,
    "src": "ch9-2"
   }
  ]
 },
 "eventual-3": {
  "audioSec": 5.233,
  "audioFrames": 157,
  "duration": 175,
  "chapterOffsetFrames": 496,
  "chapter": "eventual",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "靠谱的系统结账时只按数据库里的价格算，不看缓存里的价签。",
    "start": 0.017,
    "dur": 5.21,
    "src": "ch9-3"
   }
  ]
 },
 "recap-1": {
  "audioSec": 9.467,
  "audioFrames": 284,
  "duration": 292,
  "chapterOffsetFrames": 0,
  "chapter": "recap",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "四层放在一起看。",
    "start": 0.0,
    "dur": 1.72,
    "src": "ch10-1"
   },
   {
    "text": "删缓存：只撕不改；代价是下一次查价要多读一次数据库；一般适合大多数场景。",
    "start": 2.0,
    "dur": 7.45,
    "src": "ch10-2"
   }
  ]
 },
 "recap-2": {
  "audioSec": 8.867,
  "audioFrames": 266,
  "duration": 274,
  "chapterOffsetFrames": 292,
  "chapter": "recap",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "先改库再删缓存：空隙最小，但不是零；代价：并发读仍可能回填旧值；适合当默认写法。",
    "start": 0.0,
    "dur": 8.87,
    "src": "ch10-3"
   }
  ]
 },
 "recap-3": {
  "audioSec": 10.133,
  "audioFrames": 304,
  "duration": 312,
  "chapterOffsetFrames": 566,
  "chapter": "recap",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "重试和订阅：删不掉就再删；代价是多一套组件要维护；一般适合：改价地方少用队列，入口多用订阅。",
    "start": 0.013,
    "dur": 10.12,
    "src": "ch10-4"
   }
  ]
 },
 "recap-4": {
  "audioSec": 11.133,
  "audioFrames": 334,
  "duration": 343,
  "chapterOffsetFrames": 878,
  "chapter": "recap",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "主从延迟：副本慢半拍，回填要防着它；代价是读主库会加重主库的压力；适合刚改完就要马上看到的数据。",
    "start": 0.013,
    "dur": 11.13,
    "src": "ch10-5"
   }
  ]
 },
 "recap-5": {
  "audioSec": 8.4,
  "audioFrames": 252,
  "duration": 270,
  "chapterOffsetFrames": 1221,
  "chapter": "recap",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "最底下还有过期时间兜底，保证一张旧价签不会永远贴着，设多长就看能容忍旧多久。",
    "start": 0.0,
    "dur": 8.41,
    "src": "ch10-6"
   }
  ]
 },
