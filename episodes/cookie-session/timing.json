 },
 "protect-1": {
  "audioSec": 13.967,
  "audioFrames": 419,
  "duration": 427,
  "chapterOffsetFrames": 0,
  "provisional": false,
  "engine": "mimo",
  "voice": "冰糖",
  "scale": 1,
  "source": "timing.mimo.json:protect-1",
  "sentences": [
   {
    "text": "所以要护好手牌。",
    "start": 0.0,
    "dur": 2.071
   },
   {
    "text": "加上 H T T P Only，网页里的脚本就读不到它；加上 Secure，它只走 HTTPS，路上看不见；Same Site 限制别的网站发起的请求带上它。",
    "start": 2.351,
    "dur": 11.606
   }
  ],
  "knollChapterOffsetFrames": 0,
  "globalShift": 141
 },
 "protect-2": {
  "audioSec": 7.033,
  "audioFrames": 211,
  "duration": 266,
  "chapterOffsetFrames": 427,
