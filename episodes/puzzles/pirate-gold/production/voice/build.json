   "startSample": 881589,
   "endSample": 1073599,
   "lufs": -15.8,
   "startFrame": 550.99,
   "endFrame": 671.0,
   "maxInnerSilenceS": 0.21
  },
  {
   "id": "03-preferences-1",
   "shot": "03-preferences",
   "text": "每人先求活命，再求多拿钱；同样安全、钱也一样，就投反对。",
   "tts": "每人先求活命，再求多拿钱；同样安全、钱也一样，就投反对。好。",
   "take": "a",
   "tailCut": 0.43,
   "gapBefore": 0.7,
   "startSample": 1107199,
   "endSample": 1388219,
   "lufs": -15.8,
   "startFrame": 692.0,
   "endFrame": 867.64,
   "maxInnerSilenceS": 0.24
  },
  {
   "id": "03-preferences-2",
   "shot": "03-preferences",
   "text": "大家都明白彼此的判断，只按当前分法投票，没有私下交易或未来承诺。",
   "tts": "大家都明白彼此的判断，只按当前分法投票，没有私下交易或未来承诺。好。",
   "take": "a",
