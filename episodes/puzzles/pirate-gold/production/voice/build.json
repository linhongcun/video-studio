   "gapBefore": 0.7,
   "startSample": 603467,
   "endSample": 864789,
   "lufs": -15.9,
   "startFrame": 377.17,
   "endFrame": 540.49,
   "maxInnerSilenceS": 0.13
  },
  {
   "id": "02-voting-rules-2",
   "shot": "02-voting-rules",
   "text": "至少半数同意就通过，否则提案者出局，剩下的人继续。",
   "tts": "至少半数同意就通过，否则提案者出局，剩下的人继续。好。",
   "take": "a",
   "tailCut": 0.47,
