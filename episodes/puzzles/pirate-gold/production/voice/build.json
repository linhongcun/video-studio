   "endFrame": 356.17,
   "maxInnerSilenceS": 0.28
  },
  {
   "id": "02-voting-rules-1",
   "shot": "02-voting-rules",
   "text": "每轮由资历最高的人提方案，全员投票，提案者自己也算一票。",
   "tts": "每轮由资历最高的人提方案，全员投票，提案者自己也算一票。好。",
   "take": "a",
