   "endSample": 1689633,
   "lufs": -15.8,
   "startFrame": 878.14,
   "endFrame": 1056.02,
   "maxInnerSilenceS": 0.1
  },
  {
   "id": "04-backwards-1",
   "shot": "04-backwards",
   "text": "先倒过来想：提案被否决以后，剩下的人会怎样分？",
   "tts": "先倒过来想：提案被否决以后，剩下的人会怎样分？好。",
