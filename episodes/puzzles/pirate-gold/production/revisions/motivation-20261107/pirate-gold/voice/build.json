   "endSample": 258054,
   "lufs": -15.8,
   "startFrame": 9.0,
   "endFrame": 161.28,
   "maxInnerSilenceS": 0.08
  },
  {
   "id": "01-hook-2",
   "shot": "01-hook",
   "text": "他们按资历从高到低，固定编号为一到五，金币必须整枚分完。",
   "tts": "他们按资历从高到低，固定编号为一到五，金币必须整枚分完。好。",
   "take": "a",
   "tailCut": 0.32,
   "gapBefore": 0.35,
   "startSample": 274854,
   "endSample": 569867,
   "lufs": -15.8,
   "startFrame": 171.78,
   "endFrame": 356.17,
   "maxInnerSilenceS": 0.28
  },
  {
   "id": "02-voting-rules-1",
   "shot": "02-voting-rules",
   "text": "每轮由资历最高的人提方案，全员投票，提案者自己也算一票。",
   "tts": "每轮由资历最高的人提方案，全员投票，提案者自己也算一票。好。",
   "take": "a",
   "tailCut": 0.4,
   "gapBefore": 0.7,
   "startSample": 603467,
   "endSample": 864789,
   "lufs": -15.9,
   "startFrame": 377.17,
   "endFrame": 540.49,
   "maxInnerSilenceS": 0.13
  },
  {
   "id": "02-voting-rules-2",
   "shot": "02-voting-rules",
   "text": "至少半数同意就通过，否则提案者出局，剩下的人继续。",
   "tts": "至少半数同意就通过，否则提案者出局，剩下的人继续。好。",
   "take": "a",
   "tailCut": 0.47,
   "gapBefore": 0.35,
   "startSample": 881589,
   "endSample": 1073599,
   "lufs": -15.8,
   "startFrame": 550.99,
   "endFrame": 671.0,
   "maxInnerSilenceS": 0.21
  },
  {
   "id": "03-preferences-1",
   "shot": "03-preferences",
   "text": "每人先求活命，再求多拿钱；同样安全、钱也一样，就投反对。",
   "tts": "每人先求活命，再求多拿钱；同样安全、钱也一样，就投反对。好。",
   "take": "a",
   "tailCut": 0.43,
   "gapBefore": 0.7,
   "startSample": 1107199,
   "endSample": 1388219,
   "lufs": -15.8,
   "startFrame": 692.0,
   "endFrame": 867.64,
   "maxInnerSilenceS": 0.24
  },
  {
   "id": "03-preferences-2",
   "shot": "03-preferences",
   "text": "大家都明白彼此的判断，只按当前分法投票，没有私下交易或未来承诺。",
   "tts": "大家都明白彼此的判断，只按当前分法投票，没有私下交易或未来承诺。好。",
   "take": "a",
   "tailCut": 0.67,
   "gapBefore": 0.35,
   "startSample": 1405019,
   "endSample": 1689633,
   "lufs": -15.8,
   "startFrame": 878.14,
   "endFrame": 1056.02,
   "maxInnerSilenceS": 0.1
  },
  {
   "id": "04-backwards-1",
   "shot": "04-backwards",
   "text": "判断五个人时谁会支持一号，得先知道：否决一号后，四个人怎样分；而四个人又要看三个人的结果，所以我们一直追到两个人。",
   "tts": "判断五个人时谁会支持一号，得先知道：否决一号后，四个人怎样分；而四个人又要看三个人的结果，所以我们一直追到两个人。好。",
   "take": "motivation",
   "tailCut": 0.37,
   "gapBefore": 0.7,
   "startSample": 1723233,
   "endSample": 2232087,
   "lufs": -16.0,
   "startFrame": 1077.02,
   "endFrame": 1395.05,
   "maxInnerSilenceS": 0.17
  },
  {
   "id": "04-backwards-2",
   "shot": "04-backwards",
   "text": "两个人时，提案者自己的一票就达到半数，不必争取别人，结果能直接确定；再带着这个答案，依次推回三人、四人、五人局，逐层判断谁肯支持。",
   "tts": "两个人时，提案者自己的一票就达到半数，不必争取别人，结果能直接确定；再带着这个答案，依次推回三人、四人、五人局，逐层判断谁肯支持。好。",
   "take": "motivation",
   "tailCut": 0.46,
   "gapBefore": 0.35,
   "startSample": 2248887,
   "endSample": 2841873,
   "lufs": -16.0,
   "startFrame": 1405.55,
   "endFrame": 1776.17,
   "maxInnerSilenceS": 0.24
  },
