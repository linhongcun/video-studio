    },
    {
      "id": "19-loss-budget-2",
      "shot": "19-loss-budget",
      "text": "六场最多二十四次，刚好够其余二十四匹各输一次。",
      "tts": "六场最多二十四次，刚好够其余二十四匹各输一次。好。",
      "take": "a",
      "tailCut": 0.53,
      "gapBefore": 0.45,
      "startSample": 10358462,
      "endSample": 10634420,
      "lufs": -16.0,
      "startFrame": 6474.04,
      "endFrame": 6646.51,
      "maxInnerSilenceS": 0.08
    },
    {
      "id": "20-no-repeat-loss-1",
      "shot": "20-no-repeat-loss",
      "text": "同一匹若输第二次，就会占掉一个名额，让另一匹仍没输过。",
      "tts": "同一匹若输第二次，就会占掉一个名额，让另一匹仍没输过。好。",
      "take": "a",
      "tailCut": 0.39,
      "gapBefore": 0.8,
      "startSample": 10672820,
      "endSample": 10957492,
      "lufs": -15.8,
      "startFrame": 6670.51,
      "endFrame": 6848.43,
      "maxInnerSilenceS": 0.18
    },
    {
      "id": "20-no-repeat-loss-2",
      "shot": "20-no-repeat-loss",
      "text": "因此，想用六场确认冠军，任何马都不能输第二次。",
      "tts": "因此，想用六场确认冠军，任何马都不能输第二次。好。",
      "take": "a",
      "tailCut": 0.54,
      "gapBefore": 0.45,
      "startSample": 10979092,
      "endSample": 11216618,
      "lufs": -16.2,
      "startFrame": 6861.93,
      "endFrame": 7010.39,
      "maxInnerSilenceS": 0.16
    },
    {
      "id": "21-hard-case-1",
      "shot": "21-hard-case",
      "text": "无论第一场选哪五匹，都可能有真正的第一和第三，却没有第二。",
      "tts": "无论第一场选哪五匹，都可能有真正的第一和第三，却没有第二。好。",
      "take": "a",
      "tailCut": 0.53,
      "gapBefore": 0.8,
      "startSample": 11255018,
      "endSample": 11541609,
      "lufs": -16.0,
      "startFrame": 7034.39,
      "endFrame": 7213.51,
      "maxInnerSilenceS": 0.3
    },
    {
      "id": "21-hard-case-2",
      "shot": "21-hard-case",
      "text": "要保证成功，这种可能也必须解决。",
      "tts": "要保证成功，这种可能也必须解决。好。",
      "take": "a",
      "tailCut": 0.43,
      "gapBefore": 0.45,
