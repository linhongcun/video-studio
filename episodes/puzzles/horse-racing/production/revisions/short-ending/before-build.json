      "lufs": -16.1,
      "startFrame": 7227.01,
      "endFrame": 7341.59,
      "maxInnerSilenceS": 0.21
    },
    {
      "id": "22-meet-again-1",
      "shot": "22-meet-again",
      "text": "第三首场已输给第一，若以后再与第二同场，就会输第二次。",
      "tts": "第三首场已输给第一，若以后再与第二同场，就会输第二次。好。",
      "take": "a",
