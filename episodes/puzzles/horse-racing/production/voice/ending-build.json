   "maxInnerSilenceS": 0.31
  },
  {
   "id": "19-loss-budget-1",
   "shot": "19-loss-budget",
   "text": "一场最多五匹，最多四匹没拿第一，也就是四次落败。",
   "tts": "一场最多五匹，最多四匹没拿第一，也就是四次落败。好。",
   "take": "b",
   "tailCut": 0.37,
   "gapBefore": 0.8,
   "startSample": 620834,
   "endSample": 936862,
   "lufs": -15.9,
   "startFrame": 388.02,
   "endFrame": 585.54,
   "maxInnerSilenceS": 0.33
  },
  {
   "id": "19-loss-budget-2",
   "shot": "19-loss-budget",
   "text": "六场最多二十四次，刚好够其余二十四匹各输一次。",
   "tts": "六场最多二十四次，刚好够其余二十四匹各输一次。好。",
   "take": "a",
   "tailCut": 0.53,
   "gapBefore": 0.45,
   "startSample": 958462,
   "endSample": 1234420,
   "lufs": -16.0,
   "startFrame": 599.04,
   "endFrame": 771.51,
   "maxInnerSilenceS": 0.08
  },
  {
   "id": "20-no-repeat-loss-1",
   "shot": "20-no-repeat-loss",
   "text": "同一匹若输第二次，就会占掉一个名额，让另一匹仍没输过。",
   "tts": "同一匹若输第二次，就会占掉一个名额，让另一匹仍没输过。好。",
   "take": "a",
   "tailCut": 0.39,
   "gapBefore": 0.8,
   "startSample": 1272820,
   "endSample": 1557492,
   "lufs": -15.8,
   "startFrame": 795.51,
   "endFrame": 973.43,
   "maxInnerSilenceS": 0.18
  },
  {
   "id": "20-no-repeat-loss-2",
   "shot": "20-no-repeat-loss",
   "text": "因此，想用六场确认冠军，任何马都不能输第二次。",
   "tts": "因此，想用六场确认冠军，任何马都不能输第二次。好。",
   "take": "a",
   "tailCut": 0.54,
   "gapBefore": 0.45,
   "startSample": 1579092,
   "endSample": 1816618,
   "lufs": -16.2,
   "startFrame": 986.93,
   "endFrame": 1135.39,
   "maxInnerSilenceS": 0.16
  },
  {
   "id": "21-hard-case-1",
   "shot": "21-hard-case",
   "text": "无论第一场选哪五匹，都可能有真正的第一和第三，却没有第二。",
   "tts": "无论第一场选哪五匹，都可能有真正的第一和第三，却没有第二。好。",
   "take": "a",
   "tailCut": 0.53,
   "gapBefore": 0.8,
   "startSample": 1855018,
   "endSample": 2141609,
   "lufs": -16.0,
   "startFrame": 1159.39,
   "endFrame": 1338.51,
   "maxInnerSilenceS": 0.3
  },
  {
   "id": "21-hard-case-2",
   "shot": "21-hard-case",
   "text": "要保证成功，这种可能也必须解决。",
   "tts": "要保证成功，这种可能也必须解决。好。",
