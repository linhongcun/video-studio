  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "办法是在厨师手边放一张备菜台。",
    "start": 0.0,
    "dur": 2.943
   },
   {
    "text": "热门的菜提前切好摆在台上，点单来了，伸手就拿，不用跑仓库。",
    "start": 3.223,
    "dur": 5.728
   }
  ],
  "source": "/workspace/share/ep8-timing.json:hit-miss-1",
