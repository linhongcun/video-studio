  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "这张台子就是服务端缓存，常用的工具叫 Redis，数据放在内存里，拿起来特别快。",
    "start": -0.002,
    "dur": 6.822
   }
  ],
  "source": "/workspace/share/ep8-timing.json:hit-miss-2"
 },
 "hit-miss-3": {
  "start": 1768,
  "duration": 381,
  "audioFrames": 371,
  "audioSec": 12.367,
  "chapter": "prep",
  "chapterOffsetFrames": 490,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "台上正好有，直接拿走，这就叫缓存命中。",
    "start": -0.0,
    "dur": 4.371
   },
   {
    "text": "台上没有，就去仓库拿一次，这叫缓存没命中，顺手在台上放一份，下一单就能直接拿了。",
    "start": 4.651,
    "dur": 7.707
   }
  ],
