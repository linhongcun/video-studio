    },
    {
     "text": "先去景区门口看一看。",
     "start": 1.31,
     "dur": 1.904
    }
   ]
  },
  "no-limit-1": {
   "start": 600,
   "duration": 373,
   "audioFrames": 365,
   "audioSec": 12.167,
   "chapter": "no-limit",
   "chapterOffsetFrames": 0,
   "engine": "mimo",
   "model": "mimo-v2.5-tts",
   "voice": "冰糖",
   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "假设一个景区一次只装得下一千人，节假日却来了一万人。",
     "start": 0.0,
     "dur": 5.489
    },
    {
     "text": "要是大门敞开，所有人一起涌进去，路被堵死，到处挤满了人，谁都玩不成。",
     "start": 5.769,
     "dur": 6.399
    }
   ]
  },
  "no-limit-2": {
   "start": 973,
   "duration": 220,
   "audioFrames": 210,
   "audioSec": 7.0,
   "chapter": "no-limit",
   "chapterOffsetFrames": 373,
   "engine": "mimo",
   "model": "mimo-v2.5-tts",
   "voice": "冰糖",
   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "网站也是这样：请求一下子太多，服务器被挤垮，连原本能买到票的人也买不到了。",
     "start": 0.015,
     "dur": 6.994
    }
   ]
  },
  "limit-1": {
   "start": 1193,
   "duration": 367,
   "audioFrames": 359,
   "audioSec": 11.967,
   "chapter": "limit",
   "chapterOffsetFrames": 0,
   "engine": "mimo",
   "model": "mimo-v2.5-tts",
   "voice": "冰糖",
   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "办法是在门口限量放人。",
     "start": 0.0,
     "dur": 2.606
    },
    {
     "text": "里面装得下多少，门口就放多少，超出的人先请你在外面等一等。",
     "start": 2.886,
     "dur": 5.314
    },
    {
     "text": "这种主动控制进来人数的做法，叫限流。",
     "start": 8.48,
     "dur": 3.471
    }
   ]
  },
  "limit-2": {
   "start": 1560,
   "duration": 327,
   "audioFrames": 317,
   "audioSec": 10.567,
   "chapter": "limit",
   "chapterOffsetFrames": 367,
   "engine": "mimo",
   "model": "mimo-v2.5-tts",
   "voice": "冰糖",
   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "放多少，常用每秒处理的请求数来算，简称 QPS。",
     "start": -0.002,
     "dur": 5.244
    },
    {
     "text": "你看到的那句系统繁忙，就是门口在说：再等等。",
     "start": 5.522,
     "dur": 5.047
    }
   ]
  },
