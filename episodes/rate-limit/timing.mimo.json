   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "人实在太多时，先关掉拍照打卡这种不重要的项目，保住最主要的游览，这种做法就叫降级。",
     "start": 0.013,
     "dur": 8.554
    }
   ]
  },
  "recap-1": {
   "start": 3146,
