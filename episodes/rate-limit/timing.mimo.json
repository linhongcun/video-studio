   "provisional": false,
   "sentences": [
    {
     "text": "门口怎么数人？",
     "start": 0.0,
     "dur": 1.459
    },
    {
     "text": "常用的办法叫令牌桶。",
     "start": 1.739,
     "dur": 2.25
    },
    {
     "text": "门口放一个桶，按固定的速度往里放门票，一秒放几张。",
     "start": 4.269,
     "dur": 4.796
    }
   ]
  },
  "token-bucket-2": {
   "start": 2167,
   "duration": 334,
   "audioFrames": 324,
   "audioSec": 10.8,
   "chapter": "token-bucket",
   "chapterOffsetFrames": 280,
   "engine": "mimo",
   "model": "mimo-v2.5-tts",
   "voice": "冰糖",
   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "来一个人拿走一张，拿到票才能进，桶空了就请你稍后。",
     "start": 0.012,
     "dur": 4.343
    },
    {
     "text": "没人来的时候，票会在桶里攒一些，所以一小波人突然到来，也能先放进去。",
     "start": 4.635,
     "dur": 6.174
    }
   ]
  },
  "breaker-1": {
   "start": 2501,
   "duration": 378,
   "audioFrames": 370,
   "audioSec": 12.333,
   "chapter": "breaker",
   "chapterOffsetFrames": 0,
   "engine": "mimo",
   "model": "mimo-v2.5-tts",
   "voice": "冰糖",
   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "限流管的是门口，还有两招常跟它一起用。",
     "start": 0.0,
     "dur": 3.156
    },
    {
     "text": "要是里面某个景点出了故障，门口干脆先暂停往那边放人，过一会再派人去看看，好了再放，这叫熔断。",
     "start": 3.436,
     "dur": 8.897
    }
   ]
  },
  "breaker-2": {
   "start": 2879,
   "duration": 267,
   "audioFrames": 257,
