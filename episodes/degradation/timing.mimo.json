  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "算一个到手价，后台要同时去问商品价格、优惠券和红包几个服务，全回来才能算。",
    "start": 0.0,
    "dur": 7.603
   },
   {
    "text": "大促时红包服务卡住了，到手价计算就一直等着它，等的请求越积越多。",
    "start": 7.883,
    "dur": 7.331
   },
   {
    "text": "很快，连购物车和结算页的价格都算不出来。",
    "start": 15.494,
    "dur": 3.766
   }
  ],
  "source": "/workspace/share/ep12-timing.json:problem-1"
 },
