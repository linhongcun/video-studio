  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "购物车到结算这条算价格的路，是整个网站最要紧的一段，叫核心链路。",
    "start": 0.007,
    "dur": 6.14
   },
   {
    "text": "一个服务卡住，拖垮整条链路，这就是常说的雪崩。",
    "start": 6.427,
    "dur": 4.728
   }
  ],
  "source": "/workspace/share/ep12-timing.json:problem-2",
