  "chapterOffsetFrames": 52,
  "chapter": "replica",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "真正改数据的那一台，就像赛场，叫主库。",
    "start": 0.012,
    "dur": 3.645,
    "src": "ch4-2"
   },
   {
    "text": "照着它原样抄一份、一直跟着播的，就像电视，叫从库。",
    "start": 3.937,
    "dur": 5.351,
    "src": "ch4-3"
   },
   {
    "text": "这套做法，叫主从复制。",
    "start": 9.568,
    "dur": 2.337,
    "src": "ch4-4"
   }
  ],
  "origDuration": 375,
  "holdAt": 375,
  "extraHold": 35,
  "labelHold": 35
 },
 "split-1": {
