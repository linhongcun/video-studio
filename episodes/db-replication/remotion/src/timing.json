  "audioFrames": 274,
  "duration": 283,
  "chapterOffsetFrames": 0,
  "chapter": "split",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "为什么要这么麻烦？",
    "start": 0.0,
    "dur": 1.449,
    "src": "ch5-1"
   },
   {
    "text": "因为看的人太多了。",
    "start": 1.729,
    "dur": 1.481,
    "src": "ch5-2"
   },
   {
    "text": "改数据的事，只在主库做；查数据的人，分到各台从库去看。",
    "start": 3.49,
    "dur": 5.66,
    "src": "ch5-3"
   }
  ]
 },
 "split-2": {
  "audioSec": 10.833,
  "audioFrames": 325,
  "duration": 343,
  "chapterOffsetFrames": 283,
  "chapter": "split",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "观众再多，赛场也不挤。",
    "start": 0.0,
    "dur": 2.645,
    "src": "ch5-4"
   },
   {
    "text": "这就叫读写分离。",
    "start": 2.922,
    "dur": 2.185,
    "src": "ch5-5"
   },
   {
    "text": "从库还能拿来备份；主库要是坏了，也能挑一台从库顶上。",
    "start": 5.387,
    "dur": 5.446,
    "src": "ch5-6"
   }
  ]
 },
