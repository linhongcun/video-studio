{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "remotion": [
        "./node_modules/remotion"
      ],
      "@storyboard": [
        "../storyboard.json",
        "../storyboard.prevoice.json"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
