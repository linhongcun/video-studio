  "quotations": [
    {
      "id": "R1",
      "text": "The Redis LRU algorithm uses an approximation of the least recently used\nkeys rather than calculating them exactly. It samples a small number of keys\nat random and then evicts the ones with the longest time since last access.",
      "locator": "Approximated LRU algorithm, opening paragraph",
      "evidence": "episodes/redis/redis-lru/production/sources/key-eviction.md"
    },
    {
      "id": "R2",
      "text": "/* To improve the quality of the LRU approximation we take a set of keys\n * that are good candidate for eviction across performEvictions() calls.\n *\n * Entries inside the eviction pool are taken ordered by idle time, putting\n * greater idle times to the right (ascending order).",
      "locator": "lines24–29; EVPOOL_SIZE line36; evictionPoolPopulate lines134–224; performEvictions lines575–645",
      "evidence": "episodes/redis/redis-lru/production/sources/evict.c"
    }
