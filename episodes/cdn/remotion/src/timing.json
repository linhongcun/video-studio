  "source": "/workspace/share/ep5-timing.json:origin-1",
  "sentences": [
   {
    "text": "想象一家只有一个总仓的网店。",
    "start": 0.0,
    "dur": 2.627
   },
   {
    "text": "所有人下单，都从总仓发货：离得远的，等得久；一到大促，总仓门口就堵死了。",
    "start": 2.907,
    "dur": 7.352
   }
  ]
 },
 "origin-2": {
