  "labelHold": 27
 },
 "solution-2": {
  "audioSec": 10.567,
  "audioFrames": 317,
  "duration": 327,
  "chapterOffsetFrames": 297,
  "chapter": "solution",
  "provisional": false,
  "engine": "mimo",
  "voice": "冰糖",
  "scale": 1,
  "source": "/workspace/share/ep6-timing.json:solution-2",
  "sentences": [
   {
    "text": "客人进门先找导购，导购把人分到空闲的柜台。",
    "start": 0.006,
    "dur": 4.341
   },
   {
    "text": "你还是进同一家店，地址也没变，背后其实好几家柜台在接单，队伍就短了。",
    "start": 4.627,
    "dur": 5.946
   }
  ]
 },
 "methods-1": {
