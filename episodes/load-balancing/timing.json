  "source": "/workspace/share/ep6-timing.json:solution-1",
  "sentences": [
   {
    "text": "办法很简单：多开几家柜台，也就是多台后端服务器一起干活；门口再站一个导购，叫负载均衡器。",
    "start": 0.0,
    "dur": 9.626
   }
  ],
  "origDuration": 297,
  "holdAt": 297,
