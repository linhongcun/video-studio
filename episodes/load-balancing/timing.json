  "sentences": [
   {
    "text": "导购怎么分人？",
    "start": 0.0,
    "dur": 1.542
   },
   {
    "text": "常见有两种。",
    "start": 1.822,
    "dur": 1.21
   },
   {
    "text": "第一种叫轮询：一人一家柜台，轮着来叫号。",
    "start": 3.312,
    "dur": 4.383
   }
  ]
 },
 "methods-2": {
  "audioSec": 10.567,
  "audioFrames": 317,
  "duration": 327,
  "chapterOffsetFrames": 239,
  "chapter": "methods",
  "provisional": false,
  "engine": "mimo",
  "voice": "冰糖",
  "scale": 1,
  "source": "/workspace/share/ep6-timing.json:methods-2",
  "sentences": [
   {
    "text": "第二种叫最少连接：哪家柜台手里单子少，就往哪指，忙的时候更公平。",
    "start": 0.007,
    "dur": 6.924
   },
   {
    "text": "不过，不管哪种分法，前提是柜台得开着。",
    "start": 7.211,
    "dur": 3.342
   }
  ]
 },
