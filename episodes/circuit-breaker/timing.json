 "avalanche-1": {
  "start": 581,
  "duration": 245,
  "audioFrames": 236,
  "audioSec": 7.867,
  "chapter": "avalanche",
  "chapterOffsetFrames": 0,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "商品页要展示推荐，就得去问推荐服务。",
    "start": 0.0,
    "dur": 3.599
   },
   {
    "text": "高峰时推荐服务卡住了，商品页就一直等着它。",
    "start": 3.879,
    "dur": 4.001
   }
  ],
  "source": "/workspace/share/ep12-timing.json:avalanche-1"
 },
 "avalanche-2": {
  "start": 826,
  "duration": 432,
  "audioFrames": 375,
  "audioSec": 12.5,
  "chapter": "avalanche",
  "chapterOffsetFrames": 245,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "等的人越积越多，商品页也跟着卡住，接着连下单服务都被拖慢。",
    "start": -0.007,
    "dur": 5.213
   },
   {
    "text": "一个服务出问题，一层层往上传，最后整个网站都崩了，这就叫雪崩。",
    "start": 5.486,
    "dur": 7.018
   }
  ],
  "source": "/workspace/share/ep12-timing.json:avalanche-2",
