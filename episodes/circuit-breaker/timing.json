  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "大促时，你在结算页准备付款，后台有个运费险服务突然出了故障。",
    "start": 0.0,
    "dur": 5.417
   },
   {
    "text": "可你会发现，照样能下单付款，整个网站没跟着崩。",
    "start": 5.697,
    "dur": 4.343
   }
  ],
  "source": "/workspace/share/ep13-timing.json:hook-1"
 },
 "hook-2": {
