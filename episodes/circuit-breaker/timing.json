  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "简单说，熔断是出事后被动跳闸，降级是提前主动取舍，两招常常一起用。",
    "start": 0.0,
    "dur": 7.241
   },
   {
    "text": "再把扛住高峰四招放在一起：消息队列让订单排队不丢，限流守住门口，幂等保证只扣一次钱，熔断降级防止一个挂了全站都崩。",
    "start": 7.521,
    "dur": 12.452
   }
  ],
  "source": "/workspace/share/ep12-timing.json:recap-1",
