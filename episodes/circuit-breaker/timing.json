  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "跳闸以后，也不能一直断着。",
    "start": 0.0,
    "dur": 2.401
   },
   {
    "text": "过一会儿，网站会先放一个请求过去试一试，这个状态叫半开。",
    "start": 2.681,
    "dur": 5.418
   }
  ],
  "source": "/workspace/share/ep12-timing.json:half-open-1"
 },
 "half-open-2": {
  "start": 2013,
  "duration": 368,
  "audioFrames": 358,
  "audioSec": 11.933,
  "chapter": "half-open",
  "chapterOffsetFrames": 251,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "试成功了，说明推荐服务好了，就合上闸恢复调用；还是失败，就继续断开，过一阵再试。",
    "start": 0.012,
    "dur": 6.836
   },
   {
    "text": "另外每次调用都设个等待上限，叫超时，绝不死等。",
    "start": 7.128,
    "dur": 4.801
   }
  ],
  "source": "/workspace/share/ep12-timing.json:half-open-2"
 },
 "degrade-1": {
  "start": 2381,
  "duration": 257,
  "audioFrames": 248,
  "audioSec": 8.267,
  "chapter": "degrade",
  "chapterOffsetFrames": 0,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "熔断是出了问题才跳闸。",
    "start": 0.0,
    "dur": 2.18
