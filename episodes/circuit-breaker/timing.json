  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "其实不是，是网站故意这么做的。",
    "start": -0.006,
    "dur": 3.113
   },
   {
    "text": "它在保护你最要紧的那一步，我们先看看，要是不这么做，会发生什么。",
