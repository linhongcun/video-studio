 "breaker-1": {
  "start": 1211,
  "duration": 259,
  "audioFrames": 251,
  "audioSec": 8.367,
  "chapter": "breaker",
  "chapterOffsetFrames": 0,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "想想家里的电闸。",
    "start": 0.0,
    "dur": 1.604
   },
   {
    "text": "某个电器短路了，那一路的空气开关「啪」地跳下来，只断这一路，冰箱和灯照常用。",
    "start": 1.884,
    "dur": 6.467
   }
  ],
  "source": "/workspace/share/ep12-timing.json:breaker-1"
 },
 "breaker-2": {
  "start": 1470,
  "duration": 341,
  "audioFrames": 282,
  "audioSec": 9.4,
  "chapter": "breaker",
  "chapterOffsetFrames": 259,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "网站也装了这样的开关：发现推荐服务老是出错，就先跳闸，不再去调用它，直接给个默认结果。",
    "start": -0.002,
    "dur": 7.997
   },
   {
    "text": "这就叫熔断。",
    "start": 8.275,
    "dur": 1.126
   }
  ],
  "source": "/workspace/share/ep12-timing.json:breaker-2",
  "origDuration": 292,
  "extraHold": 49,
  "holdAt": 292
 },
 "half-open-1": {
