  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "熔断以后，系统暂时不去问运费险服务，结算页少显示这一项，这一步就是上期讲的降级，下单付款照常。",
    "start": 0.0,
    "dur": 9.146
   }
  ],
