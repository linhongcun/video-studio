 },
 "degrade-2": {
  "start": 2638,
  "duration": 425,
  "audioFrames": 378,
  "audioSec": 12.6,
  "chapter": "degrade",
  "chapterOffsetFrames": 257,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "网站高峰时也一样，主动把推荐、评论这些可有可无的功能先关掉，猜你喜欢换成固定榜单，把力气留给下单和支付。",
    "start": -0.007,
    "dur": 10.247
   },
   {
    "text": "这就叫降级。",
    "start": 10.52,
    "dur": 2.09
   }
  ],
  "source": "/workspace/share/ep12-timing.json:degrade-2",
  "origDuration": 388,
  "extraHold": 37,
  "holdAt": 388
 },
 "recap-1": {
