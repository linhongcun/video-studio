     "dur": 7.808
    }
   ]
  },
  "degrade-2": {
   "start": 2912,
   "duration": 489,
   "audioFrames": 479,
   "audioSec": 15.967,
   "chapter": "degrade",
   "chapterOffsetFrames": 314,
   "engine": "mimo",
   "model": "mimo-v2.5-tts",
   "voice": "冰糖",
   "gap": 0.28,
   "scale": 1,
   "provisional": false,
   "sentences": [
    {
     "text": "还有一种是提前动手，就像用电紧张时先关空调、保冰箱。",
     "start": 0.008,
     "dur": 5.359
