 "cascade-1": {
  "start": 498,
  "duration": 298,
  "audioFrames": 290,
  "audioSec": 9.667,
  "chapter": "cascade",
  "chapterOffsetFrames": 0,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "你点下单，订单服务要先去问库存服务：还有货吗？",
    "start": 0.0,
    "dur": 4.603
   },
   {
    "text": "大促时库存服务出了故障，迟迟不回话，订单服务就一直等。",
    "start": 4.883,
    "dur": 4.778
   }
  ],
  "source": "/workspace/share/ep13-timing.json:cascade-1"
 },
 "cascade-2": {
  "start": 796,
  "duration": 411,
  "audioFrames": 382,
  "audioSec": 12.733,
  "chapter": "cascade",
  "chapterOffsetFrames": 298,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "等的请求越积越多，订单服务自己也被拖垮，连支付这些服务都跟着出问题。",
    "start": 0.008,
    "dur": 6.703
   },
   {
    "text": "一个服务出故障，一层层往外传，这就叫雪崩，也叫级联故障。",
    "start": 6.991,
    "dur": 5.759
   }
  ],
  "source": "/workspace/share/ep13-timing.json:cascade-2",
  "origDuration": 392,
  "extraHold": 19,
  "holdAt": 392
 },
 "breaker-1": {
  "start": 1188,
  "duration": 281,
  "audioFrames": 273,
  "audioSec": 9.1,
  "chapter": "breaker",
  "chapterOffsetFrames": 0,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "给每次调用设个等待上限，到点就放弃，这叫超时。",
    "start": 0.0,
    "dur": 4.765
   },
   {
    "text": "超时要有，但高峰时每个请求还是要白等一次。",
    "start": 5.045,
    "dur": 4.058
   }
  ],
  "source": "/workspace/share/ep13-timing.json:breaker-1"
 },
 "breaker-2": {
  "start": 1469,
  "duration": 195,
  "audioFrames": 187,
  "audioSec": 6.233,
  "chapter": "breaker",
  "chapterOffsetFrames": 281,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "所以还需要像家里电闸那样的开关：哪一路短路了，那一路就「啪」地跳下来。",
    "start": 0.016,
    "dur": 6.205
   }
  ],
  "source": "/workspace/share/ep13-timing.json:breaker-2"
 },
 "breaker-3": {
  "start": 1664,
  "duration": 471,
  "audioFrames": 461,
  "audioSec": 15.367,
  "chapter": "breaker",
  "chapterOffsetFrames": 476,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "网站也一样：比如最近一百次调用里一半都失败了，就跳闸，后面的请求不再去问库存服务，直接返回「系统繁忙」。",
    "start": 0.001,
    "dur": 9.969
   },
   {
    "text": "这叫熔断。",
    "start": 10.25,
    "dur": 1.077
   },
   {
    "text": "记住，熔断不能代替超时，两个要一起用。",
    "start": 11.607,
    "dur": 3.766
   }
  ],
  "source": "/workspace/share/ep13-timing.json:breaker-3"
 },
 "states-1": {
  "start": 2135,
  "duration": 418,
  "audioFrames": 408,
  "audioSec": 13.6,
  "chapter": "states",
  "chapterOffsetFrames": 0,
  "engine": "mimo",
  "model": "mimo-v2.5-tts",
  "voice": "冰糖",
  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "这里有个反直觉的地方。",
    "start": 0.0,
    "dur": 2.039
   },
   {
    "text": "熔断器有三种状态，名字跟电闸一样：电闸合上才通电。",
    "start": 2.319,
    "dur": 4.934
   },
   {
    "text": "所以熔断器「关闭」，是正常调用；「打开」，是已经跳闸，拒绝请求。",
    "start": 7.533,
    "dur": 6.062
   }
  ],
  "source": "/workspace/share/ep13-timing.json:states-1"
 },
