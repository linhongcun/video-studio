  "gap": 0.28,
  "scale": 1,
  "provisional": false,
  "sentences": [
   {
    "text": "简单说，熔断负责发现问题、及时断开，降级负责找个替代办法，让整条链路照样走完。",
    "start": 0.0,
    "dur": 8.351
   },
   {
    "text": "再把扛住高峰四招放在一起：消息队列让订单排队不丢，限流守住门口，幂等保证只扣一次钱，熔断降级防止一个挂了全站都崩。",
    "start": 8.631,
    "dur": 12.498
   }
  ],
