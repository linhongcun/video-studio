  "chapter": "autoinc",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "以 MySQL 八点四为例，本机自增只保证这一台、这一张表里不重复，不是跨站的约定。",
    "start": 0.0,
    "dur": 8.449,
