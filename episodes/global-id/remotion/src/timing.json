  "chapter": "clash",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "红站蓝站互不知道对方编到哪，就各打出一个一模一样的订单条码。",
    "start": 0.0,
    "dur": 5.522,
    "src": "ch3-1"
   }
  ]
 },
