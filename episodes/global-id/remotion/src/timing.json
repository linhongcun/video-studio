  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "新规则：每台打印机打单时，盖上现在几点的色带、本站徽章的颜色，再加同一瞬间的流水戳。",
    "start": 0.0,
    "dur": 8.998,
