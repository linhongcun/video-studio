  "chapter": "signal",
  "provisional": false,
  "engine": "knoll",
  "scale": 1,
  "sentences": [
   {
    "text": "把每个库想成一个驿站：红站、蓝站，各有一台条码打印机，各从自己的小本子往下编。",
    "start": 0.001,
    "dur": 8.067,
    "src": "ch2-2"
   }
  ]
 },
 "clash-1": {
  "audioSec": 5.533,
