  "captions": [
    {
      "shot": "01",
      "sentence": 1,
      "globalFrame": 123,
      "expectedText": "商家在订单详情里，把十七号订单标为已付款，摘要和变化记录随即更新。"
    },
    {
      "shot": "01",
      "sentence": 2,
      "globalFrame": 329,
      "expectedText": "一次状态变化，怎样让需要它的功能各自响应？"
    },
    {
      "shot": "02",
      "sentence": 1,
      "globalFrame": 512,
      "expectedText": "如果接收方经常增减，把每一方的处理都写进订单流程，修改就会牵动订单。"
    },
    {
      "shot": "02",
      "sentence": 2,
      "globalFrame": 737,
      "expectedText": "观察者模式，把来源怎样变化，和接收后做什么分开，让关心变化的接收方各自登记。"
    },
    {
      "shot": "03",
      "sentence": 1,
      "globalFrame": 1004,
      "expectedText": "先把刚才的界面展开，订单来源负责状态和通知，摘要负责显示，变化记录负责留痕。"
    },
    {
      "shot": "03",
      "sentence": 2,
      "globalFrame": 1276,
      "expectedText": "共同观察者约定，把接收变化的方式统一起来，让订单不用掌握各个接收方的响应细节。"
    },
    {
      "shot": "04",
      "sentence": 1,
      "globalFrame": 1490,
      "expectedText": "知道各自职责后，再回看这次付款前，双方怎样建立联系。"
    },
    {
      "shot": "04",
      "sentence": 2,
      "globalFrame": 1705,
      "expectedText": "订阅，就是摘要和变化记录先登记接收意愿，订单一侧保留当前接收者的名单。"
    },
    {
      "shot": "05",
      "sentence": 1,
      "globalFrame": 1947,
      "expectedText": "订阅关系建立后，订单先变为已付款，再把订单号和新状态通知当前接收者。"
    },
    {
      "shot": "05",
      "sentence": 2,
      "globalFrame": 2171,
      "expectedText": "摘要收到后更新显示，变化记录收到后追加事实；收到后怎样处理，由各观察者负责。"
    },
    {
      "shot": "06",
      "sentence": 1,
      "globalFrame": 2365,
      "expectedText": "这次两个模块都收到了，接下来关闭摘要，让它退出。"
    },
    {
      "shot": "06",
      "sentence": 2,
      "globalFrame": 2534,
      "expectedText": "取消订阅时，把摘要从名单移除，变化记录继续保留。"
    },
    {
      "shot": "07",
      "sentence": 1,
      "globalFrame": 2727,
      "expectedText": "同一订单接着变为已发货，订单只通知仍在名单里的变化记录。"
    },
    {
      "shot": "07",
      "sentence": 2,
      "globalFrame": 2914,
      "expectedText": "记录新增已发货，退出的摘要没有再收到这条消息。"
    },
    {
      "shot": "08",
      "sentence": 1,
      "globalFrame": 3102,
      "expectedText": "两次变化可以看到，接收方能够加入或退出，订单不必写进它们各自的处理细节。"
    },
    {
      "shot": "08",
      "sentence": 2,
      "globalFrame": 3351,
      "expectedText": "前提是共同约定保持一致；订阅关系和退出时机仍要维护，简单固定的联系也可以直接调用。"
    },
    {
      "shot": "09",
      "sentence": 1,
      "globalFrame": 3595,
      "expectedText": "实战中，通常借助已有事件机制；跨服务时，常用MQ的发布订阅来承接通知。"
    },
    {
      "shot": "09",
      "sentence": 2,
      "globalFrame": 3798,
      "expectedText": "订单发布变化事件，各订阅方分别处理，延续的还是观察者各自响应的思想。"
    },
    {
      "shot": "10",
      "sentence": 1,
      "globalFrame": 3997,
      "expectedText": "回到最初的问题：订单负责变化和通知，观察者负责各自响应。"
    },
    {
      "shot": "10",
      "sentence": 2,
      "globalFrame": 4193,
      "expectedText": "用可增减的订阅关系连接双方，这就是观察者模式的核心。"
    }
  ],
