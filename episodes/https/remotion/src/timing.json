  "speed": 1.18,
  "leadTrimSec": 0.0,
  "oldAudioSec": 4.533,
  "sentences": [
   {
    "text": "非对称密码用的是一对密钥：公钥可以公开，私钥只有自己保管。",
    "start": 0.0,
    "dur": 4.36
   }
  ]
