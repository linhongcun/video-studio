  "quotations": [
    {
      "id": "R1",
      "text": "A province is a group of directly or indirectly connected cities and no other cities outside of the group.",
      "locator": "Description:definition of province",
      "evidence": "episodes-codex/number-of-provinces/research/source-access.json"
    },
    {
      "id": "R2",
      "text": "The union–find data type models a collection of sets containing n elements, with each element in exactly one set.",
