  "rows": [
    {
      "id": "01-input-matrix-1",
      "text": "省份数量这道题，输入是一个二维数组；行和列都对应城市，一表示直接相连，零表示没有直连。",
      "tts": "省份数量这道题，输入是一个二维数组；行和列都对应城市，一表示直接相连，零表示没有直连。好。",
      "status": "new-tts",
      "selectedTake": "matrix-a"
    },
    {
      "id": "01-input-matrix-2",
      "text": "要返回的是省份总数；这个教学示例有六座城市，行列下标零到五，画图时依次标成A到F。",
      "tts": "要返回的是省份总数；这个教学示例有六座城市，行列下标零到五，画图时依次标成A到F。好。",
      "status": "new-tts",
      "selectedTake": "matrix-a"
    },
    {
      "id": "02-matrix-to-graph-1",
      "text": "看行零、列一，这里是一，表示A和B直接相连；行零、列二是零，A和C之间不画直线。",
      "tts": "看行零、列一，这里是一，表示A和B直接相连；行零、列二是零，A和C之间不画直线。好。",
      "status": "new-tts",
      "selectedTake": "matrix-a"
    },
    {
      "id": "02-matrix-to-graph-2",
      "text": "照着表，再画出B连C、D连E；对角线只表示自己，F没有连接其他城市。",
      "tts": "照着表，再画出B连C、D连E；对角线只表示自己，F没有连接其他城市。好。",
      "status": "new-tts",
      "selectedTake": "matrix-a"
    },
    {
      "id": "03-province-1",
      "text": "题目把直接或间接相连的城市算作一个省份；A和C不直连，却能经过B连通。",
      "tts": "题目把直接或间接相连的城市算作一个省份；A和C不直连，却能经过B连通。好。",
      "status": "new-tts",
      "selectedTake": "matrix-a"
    },
    {
      "id": "03-province-2",
      "text": "所以ABC算一省，DE算一省，F独立也算一省，最后返回三。",
      "tts": "所以ABC算一省，DE算一省，F独立也算一省，最后返回三。好。",
      "status": "new-tts",
      "selectedTake": "matrix-a"
    },
