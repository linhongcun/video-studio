{
  "name": "top-k-frequent-elements-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "render": "python3 ../../../../_shared/render_with_references.py ..",
    "render:voice": "remotion render src/index.ts Main out/voice.mp4 --codec=h264 --crf=20 --concurrency=2 --browser-executable=/usr/bin/chromium --bundle-cache=false",
    "render:mix": "python3 ../../../../_shared/music/mix_bgm.py --in out/voice.mp4 --bgm ../../../../_shared/music/Wallpaper.mp3 --mode constant --below 12 --out out/body.mp4 --report out/mix-report.json",
    "covers": "python3 ../scripts/render_covers.py --execute",
    "stills": "node scripts/qa.mjs",
    "render:body": "python3 ../render_body.py",
    "check:references": "node ../../../../../site/scripts/check-references.mjs --sources ..",
    "verify:references": "python3 ../../../../_shared/render_with_references.py .. --verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534",
    "typescript": "^7.0.2"
  }
}
