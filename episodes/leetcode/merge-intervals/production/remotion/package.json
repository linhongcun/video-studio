{
  "name": "merge-intervals-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "render": "python3 ../render.py",
    "render:voice": "remotion render src/index.ts Main out/voice.mp4 --codec=h264 --crf=20 --concurrency=2 --browser-executable=${CHROME_BIN:-google-chrome} --bundle-cache=false --color-space=bt709",
    "render:mix": "python3 ../../../../_shared/music/mix_bgm.py --in out/voice.mp4 --bgm ../../../../_shared/music/Wallpaper.mp3 --mode constant --below 12 --out out/body.mp4 --report out/mix-report.json",
    "render:body": "python3 ../render_body.py",
    "smoke:still": "remotion still src/index.ts Main out/samples/intro.png --frame=0 --scale=0.5",
    "assemble": "python3 ../assemble.py",
    "prepare:code": "python3 ../prepare_code_endcard.py",
    "freeze": "python3 ../freeze.py",
    "freeze:verify": "python3 ../freeze.py --verify",
    "check:references": "node ../../../../../site/scripts/check-references.mjs --sources ..",
    "verify:references": "python3 ../render.py --verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  }
}
