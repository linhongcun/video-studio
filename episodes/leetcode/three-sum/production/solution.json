  "lines": [
    "class Solution:",
    "    def threeSum(self, nums: list[int]) -> list[list[int]]:",
    "        a, ans = sorted(nums), []",
    "        for i in range(len(a) - 2):",
    "            if a[i] > 0:",
    "                break",
    "            if i > 0 and a[i] == a[i - 1]:",
    "                continue",
    "            l, r = i + 1, len(a) - 1",
    "            while l < r:",
    "                total = a[i] + a[l] + a[r]",
    "                if total < 0:",
    "                    l += 1",
    "                elif total > 0:",
    "                    r -= 1",
    "                else:",
    "                    ans.append([a[i], a[l], a[r]])",
    "                    left, right = a[l], a[r]",
    "                    while l < r and a[l] == left:",
    "                        l += 1",
    "                    while l < r and a[r] == right:",
    "                        r -= 1",
    "        return ans"
  ]
}
