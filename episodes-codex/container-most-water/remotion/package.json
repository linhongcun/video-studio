{
  "name": "container-most-water-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "render": "npm run render:voice && npm run render:mix",
    "render:voice": "remotion render src/index.ts Main out/voice.mp4 --codec=h264 --crf=20 --concurrency=2 --browser-executable=/usr/bin/chromium --bundle-cache=false",
    "render:mix": "python3 ../../../episodes/_shared/music/mix_bgm.py --in out/voice.mp4 --bgm ../../../episodes/_shared/music/Wallpaper.mp3 --mode constant --below 12 --out ../video.mp4 --report out/mix-report.json",
    "covers": "node scripts/covers.mjs",
    "stills": "node scripts/qa.mjs",
    "preview:proof": "node scripts/qa.mjs /tmp/container-proof --proof",
    "render:opener": "remotion render src/index.ts Main out/problem-first-intro.mp4 --frames=0-561 --codec=h264 --crf=18 --concurrency=2 --browser-executable=/usr/bin/chromium --bundle-cache=false",
    "render:reuse-body": "python3 ../../_shared/remix_opener.py .. --out out/voice.mp4 --run",
    "render:revised": "npm run render:opener && npm run render:reuse-body && npm run render:mix"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534",
    "typescript": "^7.0.2"
  }
}
