{
  "name": "kafka-send-confirmation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:references": "node ../../../site/scripts/check-references.mjs --sources ..",
    "render": "python3 ../render.py ..",
    "render:voice": "remotion render src/index.ts Main out/voice.mp4 --codec=h264 --crf=20 --concurrency=2 --browser-executable=/usr/bin/chromium --bundle-cache=false",
    "render:mix": "python3 ../../../episodes/_shared/music/mix_bgm.py --in out/voice-bt709.mp4 --bgm ../../../episodes/_shared/music/Wallpaper.mp3 --mode constant --below 12 --out out/body.mp4 --report out/mix-report.json",
    "render:body": "npm run render:voice && npm run render:normalize && npm run render:mix",
    "render:references": "npm run check:references && python3 ../freeze.py --verify && python3 ../references-renderer.py append --body out/body.mp4 --references ../references.json --output ../video.mp4 --artifacts ../revisions/reference-endcards --seconds 5",
    "verify:references": "python3 ../render.py .. --verify",
    "render:normalize": "python3 ../normalize-color.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534",
    "typescript": "^7.0.2"
  }
}
