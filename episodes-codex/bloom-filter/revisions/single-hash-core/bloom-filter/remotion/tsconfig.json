{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@storyboard": [
        "../storyboard.json",
        "./src/placeholders/storyboard.json"
      ],
      "@covers": [
        "../covers.json"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
