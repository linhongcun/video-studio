{
  "name": "agent-intro-v3-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "render": "npm run render:opening && npm run compose",
    "render:opening": "remotion render src/index.ts Main out/opening.mp4 --codec=h264 --crf=20 --concurrency=2 --frames=0-236 --muted --browser-executable=/usr/bin/chromium --bundle-cache=false",
    "compose": "python3 ../compose-revision.py",
    "covers": "node scripts/covers.mjs",
    "stills": "node scripts/qa.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534",
    "typescript": "^7.0.2"
  }
}
